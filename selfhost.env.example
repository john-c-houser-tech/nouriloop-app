# Settings for a self-hosted copy. Don't edit this file: run
#
#     scripts/selfhost-init.sh your.domain.example
#
# which copies it to selfhost.env (never committed) with the secrets generated,
# then edit selfhost.env. Guide: docs/self-hosting.md.

# --- Your address --------------------------------------------------------------
# The domain this copy is served on. Point its DNS at the server first: the web
# server gets a free HTTPS certificate for it automatically. `localhost` works for
# a trial on your own computer.
SERVER_NAME=__SERVER_NAME__
DEFAULT_URI=https://__SERVER_NAME__

# --- Secrets (generated; never change USER_SECRETS_KEY once people have saved AI
# keys: a new value makes every saved key unreadable) ----------------------------
APP_SECRET=__APP_SECRET__
USER_SECRETS_KEY=__USER_SECRETS_KEY__

# --- Database (generated; the password appears twice, keep them identical) -------
MARIADB_DATABASE=nouriloop
MARIADB_USER=nouriloop
MARIADB_PASSWORD=__DB_PASSWORD__
MARIADB_RANDOM_ROOT_PASSWORD=1
DATABASE_URL=mysql://nouriloop:__DB_PASSWORD__@database:3306/nouriloop?serverVersion=11.4.0-MariaDB&charset=utf8mb4

# --- AI (needed for photo analysis, goal coaching and the help assistant) --------
# Option 1, Anthropic directly:
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Option 2, OpenRouter, OpenAI, or your own Ollama (any OpenAI-style endpoint):
#   AI_PROVIDER=openai_compatible
#   AI_BASE_URL=https://openrouter.ai/api/v1      (Ollama: http://<host>:11434/v1)
#   AI_API_KEY=sk-or-...                           (blank for a local Ollama)
#   AI_MODEL=anthropic/claude-sonnet-4.6           (must read images for meal photos)
#   AI_MODEL_LIGHT=                                (optional cheaper text model)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_MODEL_LIGHT=
# The AI Pattern Coach on Glucose Insights (extra AI calls per user). 1 = on.
GLUCOSE_AI_INSIGHTS_ENABLED=0

# --- Email (registration, password reset, sign-in links, reminders) --------------
# Any SMTP provider. Examples:
#   MAILER_DSN=smtp://USER:PASSWORD@smtp.example.com:587
#   MAILER_DSN=null://null    (no email at all: sign-in links and resets won't work)
MAILER_DSN=null://null
# The From address must be one your mail provider lets you send as.
MAILER_FROM="My Nutrition <you@example.com>"
MAILER_REPLY_TO=you@example.com
# Where new-registration notices and feedback-form messages go.
ADMIN_EMAIL=you@example.com

# --- Your copy's identity -------------------------------------------------------
# Name shown everywhere; blank = your domain name. Please don't use "NouriLoop":
# the name and logo are NouriLoop LLC's trademarks (see README).
APP_NAME=
# A square logo image URL (optional).
APP_LOGO_URL=
# Contact shown on your privacy/terms notice and in /.well-known/security.txt.
OPERATOR_EMAIL=you@example.com
# Your own privacy policy and terms, if you have them (else a short operator page).
PRIVACY_URL=
TERMS_URL=
# Where your users can get this copy's source code (AGPL). Blank = the upstream
# repository, which is right as long as you haven't changed the code.
SOURCE_URL=

# --- Optional --------------------------------------------------------------------
# Text-message reminders through your own Twilio account:
#   TWILIO_DSN=twilio://ACCOUNT_SID:AUTH_TOKEN@default?from=%2B15551234567
TWILIO_DSN=
# Cloudflare Turnstile on the public forms (spam protection):
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
