<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"></head>
<body style="font-family: -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif; color: #212529; line-height: 1.5;">
    <h2 style="margin-bottom: 4px;">{% include '_brand_mark.html.twig' with {variant: 'email', size: 24, absolute: true} %} {{ brand.name }}</h2>
    <p>{{ 'delivery.digest.hi'|trans({'name': user.displayName}) }}</p>

    {% if noMeals %}
    <div style="border-left: 4px solid #6f42c1; padding: 8px 14px; margin: 16px 0; background: #f6f2fb;">
        <strong>{{ 'delivery.digest.no_meals_title'|trans }}</strong><br>
        {{ 'delivery.digest.no_meals_body'|trans }}
    </div>
    {% endif %}

    {% if stale %}
    <div style="border-left: 4px solid #0d6efd; padding: 8px 14px; margin: 16px 0; background: #f1f6ff;">
        <strong>{{ 'delivery.digest.stale_title'|trans }}</strong><br>
        {% if stale.last %}
            {{ 'delivery.digest.stale_last'|trans({'date': stale.last}) }}
        {% else %}
            {{ 'delivery.digest.stale_none'|trans }}
        {% endif %}
        {{ 'delivery.digest.stale_tail'|trans }}
    </div>
    {% endif %}

    {% if calorie %}
    <div style="border-left: 4px solid {{ calorie.direction == 'low' ? '#dc3545' : '#fd7e14' }}; padding: 8px 14px; margin: 16px 0; background: #fff7f3;">
        <strong>{{ 'delivery.digest.calorie_title'|trans({'date': calorie.date, 'direction': calorie.direction}) }}</strong><br>
        {# Raw numeric params — ICU formats them with the recipient locale's own
   grouping/decimals; a pre-|number_format string would bake in en-US. #}
{{ 'delivery.digest.calorie_logged'|trans({'value': calorie.value|round})|raw }}{% if calorie.average %}{{ 'delivery.digest.calorie_vs_avg'|trans({'average': calorie.average|round}) }}{% endif %}.
        {% if calorie.direction == 'low' %}
            {{ 'delivery.digest.calorie_low_note'|trans }}
        {% else %}
            {{ 'delivery.digest.calorie_high_note'|trans }}
        {% endif %}
    </div>
    {% endif %}

    {% if supplement %}
    <div style="border-left: 4px solid #198754; padding: 8px 14px; margin: 16px 0; background: #f1fbf5;">
        <strong>{{ 'delivery.digest.supp_title'|trans }}</strong><br>
        {{ 'delivery.digest.supp_lead'|trans }}
        <ul style="margin: 8px 0; padding-left: 20px;">
            {% for gap in supplement.gaps %}
            {# gap.label/suggestion come from SupplementRecommendationService — that
               service's strings localize with the supplements module. #}
            <li>{{ 'delivery.digest.supp_gap'|trans({'label': gap.label, 'pct': gap.pct})|raw }} {{ gap.suggestion }}</li>
            {% endfor %}
        </ul>
    </div>
    {% endif %}

    <p style="color: #6c757d; font-size: 13px; margin-top: 24px;">
        {{ 'delivery.digest.footer'|trans }}
    </p>
</body>
</html>
