{# i18n: team-facing (ADMIN_EMAIL) — stays English on purpose. #}
<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"></head>
<body style="font-family: -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif; color: #212529; line-height: 1.5;">
    <h2 style="margin-bottom: 4px;">{% include '_brand_mark.html.twig' with {variant: 'email', size: 24, absolute: true} %} {{ brand.name }}</h2>
    <p>A new user just registered:</p>
    <ul>
        <li><strong>Name:</strong> {{ newUser.displayName }}</li>
        <li><strong>Email:</strong> {{ newUser.email }}</li>
        <li><strong>Registered:</strong> {{ newUser.createdAt|date('M j, Y g:i A') }}</li>
    </ul>
    <p style="color: #6c757d; font-size: 13px;">
        Manage accounts on the Admin &rsaquo; Users page.
    </p>
</body>
</html>
