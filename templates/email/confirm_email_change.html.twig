<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"></head>
<body style="font-family: -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif; color: #212529; line-height: 1.5;">
    <h2 style="margin-bottom: 4px;">{% include '_brand_mark.html.twig' with {variant: 'email', size: 24, absolute: true} %} {{ brand.name }}</h2>

    <p>{{ 'delivery.email.hi'|trans({'name': user.displayName ?? newEmail}) }}</p>

    <p>{{ 'delivery.email.change_lead'|trans }}</p>

    <p style="margin: 24px 0;">
        <a href="{{ confirmUrl }}"
           style="background-color: #0f766e; color: #ffffff; text-decoration: none; padding: 12px 28px; border-radius: 6px; font-weight: 600; display: inline-block;">
            {{ 'delivery.email.change_cta'|trans }}
        </a>
    </p>

    <p style="color: #6c757d; font-size: 14px;">
        {{ 'delivery.email.change_note'|trans }}
    </p>

    <p>{{ 'delivery.email.team'|trans }}</p>
</body>
</html>
