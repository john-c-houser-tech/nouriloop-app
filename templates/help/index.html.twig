{% extends 'base.html.twig' %}

{% block title %}Help Center — NouriLoop{% endblock %}

{% block seo_jsonld %}<script type="application/ld+json">{{ jsonld_help_list()|raw }}</script>{% endblock %}

{% block body %}
<div class="container py-4" style="max-width: 900px;">
    <h1 class="fw-bold mb-1"><i class="bi bi-question-circle text-brick"></i> NouriLoop Help</h1>
    <p class="text-muted mb-4">Guides for every part of NouriLoop, in plain language. Ask a question below, or pick a topic.</p>

    <div class="card p-3 p-md-4 mb-4 shadow-sm border-brick-subtle">
        <label for="help-question" class="fw-semibold mb-2">
            <i class="bi bi-chat-dots text-brick"></i> Ask anything about NouriLoop
        </label>
        <form id="help-chat-form" class="d-flex gap-2">
            <input id="help-question" type="text" maxlength="500" autocomplete="off"
                   class="form-control" placeholder="e.g. How do I log a meal from a photo?">
            <button type="submit" id="help-ask-btn" class="btn btn-success flex-shrink-0">
                <i class="bi bi-send"></i> Ask
            </button>
        </form>
        <p class="small text-muted mt-2 mb-0">
            Answers come from NouriLoop's help guides. This is wellness guidance, not medical advice.
        </p>
        <div id="help-thread" class="mt-3 d-none" aria-live="polite"></div>
    </div>

    <h2 class="h5 fw-bold mb-3">Browse topics</h2>
    <div class="row g-3">
        {% for slug, meta in topics %}
        <div class="col-md-6">
            <a href="{{ path('app_help_show', {topic: slug}) }}"
               class="card h-100 p-3 text-decoration-none text-body border-2 help-topic-card">
                <h5 class="fw-bold mb-1">{{ meta.title }}</h5>
                <p class="small text-muted mb-0">{{ meta.summary }}</p>
            </a>
        </div>
        {% endfor %}
    </div>
</div>
{% endblock %}

{% block javascripts %}
{# Inline vanilla JS to match this app's convention (it doesn't load Stimulus). #}
<script>
(function () {
    const form = document.getElementById('help-chat-form');
    if (!form) return;
    const input = document.getElementById('help-question');
    const btn = document.getElementById('help-ask-btn');
    const thread = document.getElementById('help-thread');
    const ASK_URL = '{{ path('app_help_ask') }}';
    const MAX_EXCHANGES = 5;

    // The floating help button links here with #ask to open and focus the box.
    if (window.location.hash === '#ask') input.focus();

    function setBusy(busy) {
        btn.disabled = busy;
        input.disabled = busy;
        btn.innerHTML = busy
            ? '<span class="spinner-border spinner-border-sm"></span>'
            : '<i class="bi bi-send"></i> Ask';
    }

    function appendExchange(question) {
        const wrap = document.createElement('div');
        wrap.className = 'mb-3 pb-3 border-bottom';
        const q = document.createElement('p');
        q.className = 'fw-semibold mb-1';
        q.textContent = question;
        wrap.appendChild(q);
        const answer = document.createElement('div');
        answer.className = 'text-body';
        answer.innerHTML = '<span class="text-muted small"><span class="spinner-border spinner-border-sm"></span> Thinking…</span>';
        wrap.appendChild(answer);
        thread.prepend(wrap);
        while (thread.children.length > MAX_EXCHANGES) thread.lastElementChild.remove();
        return answer;
    }

    function renderAnswer(node, data) {
        node.innerHTML = '';
        const answer = document.createElement('div');
        answer.innerHTML = data.answerHtml || ''; // server-sanitized via inline_md
        node.appendChild(answer);
        if (Array.isArray(data.pages) && data.pages.length > 0) {
            const list = document.createElement('div');
            list.className = 'mt-2 d-flex flex-column gap-1';
            data.pages.forEach(function (page) {
                const link = document.createElement('a');
                link.className = 'small text-decoration-none';
                link.href = page.url;
                const icon = document.createElement('i');
                icon.className = 'bi bi-arrow-right-short';
                link.appendChild(icon);
                link.appendChild(document.createTextNode(' ' + page.title));
                if (page.reason) {
                    const reason = document.createElement('span');
                    reason.className = 'text-muted';
                    reason.textContent = ' — ' + page.reason;
                    link.appendChild(reason);
                }
                list.appendChild(link);
            });
            node.appendChild(list);
        }
    }

    function renderError(node, message) {
        node.innerHTML = '';
        const p = document.createElement('p');
        p.className = 'text-danger small mb-0';
        p.textContent = message;
        node.appendChild(p);
    }

    form.addEventListener('submit', async function (event) {
        event.preventDefault();
        const question = input.value.trim();
        if (question === '') return;

        thread.classList.remove('d-none');
        const node = appendExchange(question);
        setBusy(true);
        try {
            const response = await fetch(ASK_URL, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-Requested-With': 'XMLHttpRequest',
                },
                body: new URLSearchParams({ question: question }),
            });
            const data = await response.json().catch(function () { return {}; });
            if (!response.ok) {
                renderError(node, data.error || 'Something went wrong. Please try again.');
            } else {
                renderAnswer(node, data);
            }
        } catch (e) {
            renderError(node, 'Could not reach the help assistant. Please try again.');
        } finally {
            setBusy(false);
            input.value = '';
            input.focus();
        }
    });
})();
</script>
{% endblock %}
