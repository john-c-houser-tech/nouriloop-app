{% extends 'base.html.twig' %}

{% block title %}Thanks for the feedback — {{ brand.name }}{% endblock %}

{% block body %}
<div class="container py-4 text-center" style="max-width: 620px;">
    {% include '_brand_mark.html.twig' with {variant: 'auth', size: 72, class: 'mb-2', alt: brand.name} %}
    <h2 class="fw-bold mb-2">Thanks for the feedback!</h2>
    <p class="text-muted">
        We've received your message and appreciate you taking the time. If you left an
        email, we'll be in touch if a reply is needed.
    </p>
    <a href="{{ app.user ? path('app_dashboard') : path('app_login') }}" class="btn btn-outline-secondary mt-2">
        {{ app.user ? 'Back to dashboard' : 'Back to sign in' }}
    </a>
</div>
{% endblock %}
