{% extends 'base.html.twig' %}

{% block title %}Send us feedback — NouriLoop{% endblock %}

{% block body %}
<div class="container py-4" style="max-width: 620px;">
    <h2 class="fw-bold mb-1">Send us feedback</h2>
    <p class="text-muted">
        Found a bug, have an idea, or just want to say hello? We read every message.
        Name and email are optional — leave an email if you'd like a reply.
    </p>

    <div class="card p-4 mt-3">
        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

        <div class="mb-3">
            {{ form_label(form.name, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
            {{ form_widget(form.name, {'attr': {'class': 'form-control' ~ (form.name.vars.errors|length ? ' is-invalid' : '')}}) }}
            {{ form_errors(form.name) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.email, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
            {{ form_widget(form.email, {'attr': {'class': 'form-control' ~ (form.email.vars.errors|length ? ' is-invalid' : '')}}) }}
            {{ form_errors(form.email) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.message, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
            {{ form_widget(form.message, {'attr': {'class': 'form-control' ~ (form.message.vars.errors|length ? ' is-invalid' : ''), 'rows': 6, 'autofocus': true}}) }}
            {{ form_errors(form.message) }}
        </div>

        {# Honeypot — hidden from people, tempting to bots. #}
        <div style="position: absolute; left: -5000px;" aria-hidden="true">
            {{ form_label(form.website) }}
            {{ form_widget(form.website, {'attr': {'tabindex': '-1', 'autocomplete': 'off'}}) }}
        </div>

        {% if turnstileSiteKey %}
        <div class="cf-turnstile mb-3" data-sitekey="{{ turnstileSiteKey }}"></div>
        {% endif %}

        <button type="submit" class="btn btn-success fw-semibold">Send feedback</button>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}

{% block javascripts %}
{% if turnstileSiteKey %}
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
{% endif %}
{% endblock %}
