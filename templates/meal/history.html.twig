{% extends 'base.html.twig' %}
{% block title %}{{ 'meal.history.title'|trans }} — NouriLoop{% endblock %}

{% block body %}
<div class="container" style="max-width: 900px;">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-1">
        <h2 class="fw-bold mb-0"><i class="bi bi-clock-history text-brick"></i> {{ 'meal.history.heading'|trans }} {{ help_link('log-meal') }}</h2>
        <a href="{{ path('app_meal_log') }}" class="btn btn-success">
            <i class="bi bi-plus-lg"></i> {{ 'dashboard.log_meal'|trans }}
        </a>
    </div>
    <p class="text-muted mb-3">{{ 'meal.history.lead'|trans }}</p>

    <div class="card">
        <div class="card-body pb-2">
            <form method="get" action="{{ path('app_meal_history') }}" class="d-flex align-items-center flex-wrap gap-2">
                <label class="small text-muted mb-0" for="history-from">{{ 'meal.history.filter_from'|trans }}</label>
                <input type="date" id="history-from" name="from" value="{{ fromValue }}"
                       class="form-control form-control-sm" style="max-width: 170px;">
                <label class="small text-muted mb-0" for="history-to">{{ 'meal.history.filter_to'|trans }}</label>
                <input type="date" id="history-to" name="to" value="{{ toValue }}"
                       class="form-control form-control-sm" style="max-width: 170px;">
                <select name="type" class="form-select form-select-sm" style="max-width: 170px;"
                        aria-label="{{ 'meal.history.filter_type'|trans }}">
                    <option value="">{{ 'meal.history.filter_all'|trans }}</option>
                    {% for t in mealTypes %}
                    <option value="{{ t.value }}"{{ typeFilter == t ? ' selected' : '' }}>{{ t.transKey|trans }}</option>
                    {% endfor %}
                </select>
                <button type="submit" class="btn btn-sm btn-outline-secondary">{{ 'meal.history.filter_apply'|trans }}</button>
                {% if hasFilters %}
                <a href="{{ path('app_meal_history') }}" class="btn btn-sm btn-link">{{ 'meal.history.filter_clear'|trans }}</a>
                {% endif %}
            </form>
        </div>

        {% if meals is empty %}
        <div class="card-body text-center text-muted py-5">
            {% if hasFilters %}
            <p class="mb-2">{{ 'meal.history.no_match'|trans }}</p>
            <a href="{{ path('app_meal_history') }}" class="btn btn-sm btn-outline-secondary">{{ 'meal.history.filter_clear'|trans }}</a>
            {% else %}
            <i class="bi bi-clipboard-data fs-2 d-block mb-2"></i>
            <p class="mb-2">{{ 'meal.history.empty'|trans }}</p>
            <a href="{{ path('app_meal_log') }}" class="btn btn-success">
                <i class="bi bi-plus-lg"></i> {{ 'meal.history.empty_cta'|trans }}
            </a>
            {% endif %}
        </div>
        {% else %}
        <div class="list-group list-group-flush">
            {% for meal in meals %}
            <a href="{{ path('app_meal_show', {id: meal.id}) }}"
               class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-2">
                {% if meal.imagePath %}
                <img src="{{ asset(meal.imagePath) }}" alt="" class="rounded flex-shrink-0"
                     style="width: 56px; height: 56px; object-fit: cover;">
                {% else %}
                <div class="rounded bg-light d-flex align-items-center justify-content-center flex-shrink-0 text-muted"
                     style="width: 56px; height: 56px;" aria-hidden="true">
                    <i class="bi bi-card-text fs-4"></i>
                </div>
                {% endif %}
                {# overflow-hidden makes the flex item shrinkable (auto min-width
                   would otherwise defeat text-truncate on long descriptions). #}
                <div class="flex-grow-1 overflow-hidden">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <span class="badge bg-success-subtle text-success-emphasis">{{ meal.mealType.transKey|trans }}</span>
                        <small class="text-muted">{{ meal.loggedAt|local_date('MMMdjm') }}</small>
                    </div>
                    {% if meal.aiDescription %}
                    <div class="small text-truncate text-body">{{ meal.aiDescription }}</div>
                    {% endif %}
                </div>
                {% if meal.nutritionData %}
                <div class="text-end flex-shrink-0">
                    <div class="fw-semibold">{{ meal.nutritionData.calories|format_number({fraction_digit: 0}) }} <small class="text-muted fw-normal">{{ 'macro.kcal'|trans }}</small></div>
                    <small class="text-muted">
                        {{ 'macro.abbr_protein'|trans }} {{ meal.nutritionData.protein|format_number({fraction_digit: 0}) }}g
                        · {{ 'macro.abbr_carbs'|trans }} {{ meal.nutritionData.carbohydrates|format_number({fraction_digit: 0}) }}g
                        · {{ 'macro.abbr_fat'|trans }} {{ meal.nutritionData.fat|format_number({fraction_digit: 0}) }}g
                    </small>
                </div>
                {% endif %}
                <i class="bi bi-chevron-right text-muted flex-shrink-0"></i>
            </a>
            {% endfor %}
        </div>

        <div class="card-body d-flex align-items-center justify-content-between border-top">
            <small class="text-muted">
                {{ 'meal.history.showing'|trans({
                    'first': (page - 1) * perPage + 1,
                    'last': min(page * perPage, total),
                    'total': total,
                }) }}
            </small>
            {% if pages > 1 %}
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item{% if page <= 1 %} disabled{% endif %}">
                        <a href="{{ path('app_meal_history', filterParams|merge({page: page - 1})) }}"
                           class="page-link"
                           {% if page <= 1 %}aria-disabled="true" tabindex="-1"{% endif %}>{{ 'meal.history.prev'|trans }}</a>
                    </li>
                    <li class="page-item active" aria-current="page"><span class="page-link">{{ page }} / {{ pages }}</span></li>
                    <li class="page-item{% if page >= pages %} disabled{% endif %}">
                        <a href="{{ path('app_meal_history', filterParams|merge({page: page + 1})) }}"
                           class="page-link"
                           {% if page >= pages %}aria-disabled="true" tabindex="-1"{% endif %}>{{ 'meal.history.next'|trans }}</a>
                    </li>
                </ul>
            </nav>
            {% endif %}
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}
