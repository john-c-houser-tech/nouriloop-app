{% extends 'base.html.twig' %}
{% block title %}{{ 'meal.clarify.title'|trans }} — {{ brand.name }}{% endblock %}

{% block body %}
<div class="container" style="max-width: 820px;">

    <div class="d-flex align-items-center gap-3 mb-4">
        <h2 class="fw-bold mb-0"><i class="bi bi-patch-question text-warning"></i> {{ 'meal.clarify.heading'|trans }}</h2>
        {% if questions is not empty %}
        <span class="badge bg-secondary">{{ 'meal.clarify.round'|trans({'round': round}) }}</span>
        {% endif %}
    </div>

    {# AI confidence — tells the user when the estimate is solid enough to save
       vs. worth refining. Bucketing + the save/re-analyze cutoff live in
       App\Dto\ConfidenceLevel, the single source of truth shared with the
       analyzer's clarification loop. #}
    {% set conf_color = confidence.bootstrapColor %}
    {% set conf_pct = confidence.percent %}

    {# Progressive disclosure: the confident common case reads photo → numbers →
       servings → Save; the secondary sections below collapse to slim rows and
       auto-open only when the state says they matter. #}
    {% set refining = not confidence.isConfident and questions is not empty %}
    {# Auto-open the extra-photo section when a question asks for a label/packaging
       shot. Questions come back in the user's language (LocalePromptBuilder), so
       the stems cover every supported locale — a heuristic, not a contract: a
       miss just means the section stays one tap away. #}
    {% set qtext = questions|join(' ')|lower %}
    {% set labelStems = [
        'label', 'packag', 'brand', 'nutrition',
        'etiqueta', 'envase', 'marca', 'nutrici',
        'etikett', 'verpackung', 'marke', 'nährwert',
        'étiquette', 'emballage', 'marque',
        'этикет', 'упаковк', 'марк', 'состав',
        'लेबल', 'पैकेज', 'ब्रांड', 'पोषण',
    ] %}
    {% set extraOpen = extraPhotos is not empty %}
    {% for stem in labelStems %}
        {% if stem in qtext %}{% set extraOpen = true %}{% endif %}
    {% endfor %}
    {% set backdated = state.loggedAt|date('Y-m-d', false) != nowLocal|date('Y-m-d', false) %}

    {% if photo_model_failed_benchmark() %}
    {# Plan Q10: a user's own photo model that failed the benchmark warns, never blocks. #}
    <div class="alert alert-warning small py-2" id="photo-model-warning">
        <i class="bi bi-exclamation-triangle"></i>
        {{ 'meal.clarify.photo_model_failed'|trans({
            link: '<a href="' ~ path('app_settings_ai') ~ '">',
            link_end: '</a>',
        })|raw }}
    </div>
    {% endif %}
    <div class="card border-0 bg-{{ conf_color }} bg-opacity-10 mb-4">
        <div class="card-body py-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="fw-semibold"><i class="bi bi-robot text-{{ conf_color }}"></i> {{ 'meal.clarify.ai_confidence'|trans }}</span>
                <span class="badge bg-{{ conf_color }}">{{ confidence.transKey|trans }} · {{ conf_pct }}%</span>
            </div>
            <div class="progress" style="height: 6px;" role="progressbar"
                 aria-valuenow="{{ conf_pct }}" aria-valuemin="0" aria-valuemax="100">
                <div class="progress-bar bg-{{ conf_color }}" style="width: {{ conf_pct }}%"></div>
            </div>
            <small class="text-muted d-block mt-2">
                {% if confidence.isConfident %}
                    {{ 'meal.clarify.hint_confident'|trans }}
                {% elseif questions is not empty %}
                    {{ 'meal.clarify.hint_questions'|trans }}
                {% else %}
                    {{ 'meal.clarify.hint_no_more'|trans }}
                {% endif %}
            </small>
        </div>
    </div>

    <form method="post" action="{{ path('app_meal_clarify') }}" enctype="multipart/form-data">
    <input type="hidden" name="_token" value="{{ csrf_token('meal-clarify') }}">
    <div class="row g-4">

        {# Left column: photo and/or the user's own description (a photo
           submission can carry one too — it feeds the analysis) + the AI's
           description #}
        <div class="col-md-4">
            {% if state.imageWebPath %}
            <div class="card p-2 mb-3">
                <img src="{{ asset(state.imageWebPath) }}" class="img-fluid rounded" alt="{{ 'meal.clarify.your_meal_alt'|trans }}">
            </div>
            {% endif %}
            {% if state.describe|default('') is not empty %}
            <div class="card p-3 mb-3 bg-light border-0">
                <small class="text-muted fw-semibold text-uppercase d-block mb-1">
                    <i class="bi bi-pencil"></i> {{ 'meal.clarify.described_as'|trans }}
                </small>
                <p class="mb-0 small">{{ state.describe }}</p>
            </div>
            {% endif %}
            {% if description %}
            <div class="card p-3">
                <small class="text-muted fw-semibold text-uppercase d-block mb-1">{{ 'meal.clarify.ai_sees'|trans }}</small>
                <p class="mb-0 small">{{ description }}</p>
            </div>
            {% endif %}
        </div>

        {# Right column: the estimate first, then the refinement tools #}
        <div class="col-md-8">

            {# Estimated nutrition + portion control — the headline, always open #}
            <div class="card p-4 mb-3">
                <h6 class="fw-bold mb-3">
                    <i class="bi bi-pie-chart text-success"></i> {{ 'meal.clarify.nutrition_heading'|trans }}
                    <small id="nutrition-subtitle" class="text-muted fw-normal">{{ 'meal.clarify.for_one'|trans }}</small>
                </h6>
                <div class="row g-2 text-center mb-3">
                    <div class="col-3"><div class="bg-warning bg-opacity-10 rounded p-2">
                        <div class="fw-bold js-macro" data-base="{{ nutrition.calories|default(0) }}" data-suffix="">{{ nutrition.calories|default(0)|round }}</div>
                        <small class="text-muted">{{ 'macro.kcal'|trans }}</small></div></div>
                    <div class="col-3"><div class="bg-danger bg-opacity-10 rounded p-2">
                        <div class="fw-bold js-macro" data-base="{{ nutrition.protein|default(0) }}" data-suffix="g">{{ nutrition.protein|default(0)|round }}g</div>
                        <small class="text-muted">{{ 'macro.protein'|trans }}</small></div></div>
                    <div class="col-3"><div class="bg-primary bg-opacity-10 rounded p-2">
                        <div class="fw-bold js-macro" data-base="{{ nutrition.carbohydrates|default(0) }}" data-suffix="g">{{ nutrition.carbohydrates|default(0)|round }}g</div>
                        <small class="text-muted">{{ 'macro.carbs'|trans }}</small></div></div>
                    <div class="col-3"><div class="bg-info bg-opacity-10 rounded p-2">
                        <div class="fw-bold js-macro" data-base="{{ nutrition.fat|default(0) }}" data-suffix="g">{{ nutrition.fat|default(0)|round }}g</div>
                        <small class="text-muted">{{ 'macro.fat'|trans }}</small></div></div>
                </div>
                <label class="form-label fw-semibold mb-1">{{ 'meal.clarify.servings_q'|trans }}</label>
                <div class="input-group" style="max-width: 220px;">
                    <input type="number" name="portions" value="1" min="0.25" max="100" step="0.25" class="form-control">
                    <span class="input-group-text">{{ 'meal.clarify.servings_unit'|trans }}</span>
                </div>
                <div class="form-text">{{ 'meal.clarify.servings_note'|trans|raw }}</div>
                {% if glp1Mode %}
                <div class="alert alert-info small mt-2 mb-0 py-2">
                    <i class="bi bi-capsule"></i> {{ 'meal.clarify.glp1_tip'|trans|raw }}
                </div>
                {% endif %}
            </div>

            {# Clarifying questions (only rendered when the AI asked any, and while
               another round can still use the answers) #}
            {% if questions is not empty and canReanalyze %}
            <div class="card p-4 mb-3">
                <h6 class="fw-bold mb-3">
                    <i class="bi bi-question-circle text-warning"></i>
                    {{ 'meal.clarify.questions_heading'|trans }}
                </h6>
                {% for question in questions %}
                <div class="mb-3">
                    <label class="form-label fw-semibold small">{{ loop.index }}. {{ question }}</label>
                    <input type="text" name="answers[{{ loop.index0 }}]" class="form-control form-control-sm"
                           placeholder="{{ 'meal.clarify.answer_ph'|trans }}" autocomplete="off">
                </div>
                {% endfor %}
            </div>
            {% endif %}

            {# Editable ingredient list — collapsed to a count while the estimate
               is confident; auto-open in refinement mode. Hidden inputs still
               submit, so collapsing changes nothing server-side. #}
            <div class="card p-3 mb-3">
                <button type="button" class="btn p-0 border-0 bg-transparent text-start w-100 js-toggle"
                        data-target="#ingredients-body" aria-expanded="{{ refining ? 'true' : 'false' }}">
                    <span class="fw-bold small"><i class="bi bi-list-ul text-success"></i> {{ 'meal.ingredients'|trans }}</span>
                    <span class="text-muted small ms-1">{{ 'meal.clarify.ingredients_count'|trans({'count': ingredients|length}) }}</span>
                    <i class="bi bi-chevron-down float-end text-muted"></i>
                </button>
                <div id="ingredients-body" class="mt-3{{ refining ? '' : ' d-none' }}">
                    <div class="text-end mb-2"><small class="text-muted">{{ 'meal.clarify.edit_hint'|trans }}</small></div>
                    <table class="table table-sm mb-2" id="ingredients-table">
                        <thead>
                            <tr>
                                <th class="fw-semibold" style="width:50%">{{ 'meal.clarify.col_ingredient'|trans }}</th>
                                <th class="fw-semibold" style="width:20%">{{ 'meal.clarify.col_amount'|trans }}</th>
                                <th class="fw-semibold" style="width:20%">{{ 'meal.clarify.col_unit'|trans }}</th>
                                <th style="width:10%"></th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for item in ingredients %}
                        <tr>
                            <td><input type="text" name="ing_name[]" value="{{ item.name }}"
                                       class="form-control form-control-sm" required></td>
                            <td><input type="text" name="ing_amount[]" value="{{ item.amount }}"
                                       class="form-control form-control-sm" placeholder="{{ 'meal.clarify.optional_ph'|trans }}"></td>
                            <td><input type="text" name="ing_unit[]" value="{{ item.unit }}"
                                       class="form-control form-control-sm" placeholder="{{ 'meal.clarify.unit_ph'|trans }}"></td>
                            <td class="text-center">
                                <button type="button" class="btn btn-sm btn-link text-danger p-0 remove-row"
                                        title="{{ 'meal.clarify.remove'|trans }}">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </td>
                        </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                    <button type="button" id="add-ingredient" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-plus-lg"></i> {{ 'meal.clarify.add_ingredient'|trans }}
                    </button>
                    {% if ingredients|filter(i => (i.amount|default('')|trim) == '') is not empty %}
                    <div class="form-text mt-2">
                        <i class="bi bi-info-circle"></i>
                        {{ 'meal.clarify.amounts_note'|trans|raw }}
                    </div>
                    {% endif %}
                </div>
            </div>

            {# Add another photo (e.g. the nutrition label) — collapsed unless the
               AI's questions suggest one, or extras already exist. Only offered
               while another round can still use it. #}
            {% if canReanalyze %}
            <div class="card p-3 mb-3">
                <button type="button" class="btn p-0 border-0 bg-transparent text-start w-100 js-toggle"
                        data-target="#extra-photo-body" aria-expanded="{{ extraOpen ? 'true' : 'false' }}">
                    <span class="fw-bold small"><i class="bi bi-camera text-success"></i> {{ 'meal.clarify.extra_photo'|trans }}</span>
                    <span class="text-muted small ms-1">{{ 'meal.clarify.extra_photo_eg'|trans }}</span>
                    <i class="bi bi-chevron-down float-end text-muted"></i>
                </button>
                <div id="extra-photo-body" class="mt-2{{ extraOpen ? '' : ' d-none' }}">
                    <p class="small text-muted mb-2">{{ 'meal.clarify.extra_photo_lead'|trans|raw }}</p>
                    {% if extraPhotos is not empty %}
                    <div class="d-flex flex-wrap gap-2 mb-2">
                        {% for p in extraPhotos %}
                        <img src="{{ asset(p) }}" alt="{{ 'meal.clarify.added_photo_alt'|trans }}" class="rounded border"
                             style="height: 64px; width: 64px; object-fit: cover;">
                        {% endfor %}
                    </div>
                    {% endif %}
                    <input type="file" name="extra_photo" accept="image/*,.heic,.heif"
                           class="form-control form-control-sm">
                </div>
            </div>
            {% endif %}

            {# Prior Q&A summary — history, collapsed by default #}
            {% set qa_context = state.context|filter(p => p.question is defined) %}
            {% if qa_context is not empty %}
            <details class="card p-3 mb-3 bg-light border-0">
                <summary class="small text-muted fw-semibold text-uppercase">{{ 'meal.clarify.previous_answers'|trans }}</summary>
                <div class="mt-2">
                    {% for pair in qa_context %}
                    <div class="mb-1">
                        <small class="text-muted">{{ pair.question }}</small><br>
                        <small class="fw-semibold">{{ pair.answer }}</small>
                    </div>
                    {% endfor %}
                </div>
            </details>
            {% endif %}

            {# When it was eaten — a one-line summary unless it isn't today #}
            <div class="card p-3 mb-3">
                <div id="logged-summary" class="small d-flex align-items-center gap-2{{ backdated ? ' d-none' : '' }}">
                    <i class="bi bi-clock-history"></i>
                    <span>{{ 'meal.clarify.logging_for'|trans({
                        'datetime': state.loggedAt|local_date('MMMdjm'),
                    }) }}</span>
                    <a href="#" id="logged-change" class="text-decoration-none">{{ 'meal.clarify.change'|trans }}</a>
                </div>
                <div id="logged-body" class="{{ backdated ? '' : 'd-none' }}">
                    <label class="form-label fw-semibold small mb-1">
                        <i class="bi bi-clock-history"></i> {{ 'meal.clarify.when_q'|trans }}
                    </label>
                    <input type="datetime-local" name="logged_at" id="logged-at-input"
                           data-today="{{ nowLocal|date('Y-m-d', false) }}"
                           class="form-control form-control-sm"
                           style="max-width: 260px;"
                           value="{{ state.loggedAt|date('Y-m-d\\TH:i', false) }}"
                           max="{{ nowLocal|date('Y-m-d\\TH:i', false) }}">
                    <div class="form-text">{{ 'meal.clarify.when_note'|trans }}</div>
                </div>
                {# Loud flag when the meal isn't being logged for today, so reusing an older
                   photo doesn't silently backdate it. Deliberately OUTSIDE the collapsible
                   body — it must be visible even while the date row is collapsed. #}
                <div id="backdate-warning"
                     class="alert alert-warning py-2 px-3 mt-2 mb-0 small d-flex align-items-center gap-2{% if not backdated %} d-none{% endif %}"
                     style="max-width: 360px;" role="alert">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span>{{ 'meal.clarify.backdate'|trans({
                        'date': '<strong id="backdate-date">'
                            ~ state.loggedAt|local_date('EEEMMMd') ~ '</strong>',
                    })|raw }}</span>
                </div>
            </div>

            {# Favorite name — optional, revealed on demand; the default name is
               used when the favorite save button is clicked without opening this #}
            <div class="mb-3">
                <a href="#" class="small text-decoration-none js-toggle" data-target="#fav-name-wrap"
                   aria-expanded="false">
                    <i class="bi bi-star text-warning"></i> {{ 'meal.clarify.favorite_name_link'|trans }}
                </a>
                <div id="fav-name-wrap" class="d-none mt-2">
                    <input type="text" name="favorite_name" class="form-control form-control-sm"
                           maxlength="200" value="{{ favoriteDefault }}" placeholder="{{ 'meal.clarify.favorite_ph'|trans }}"
                           style="max-width: 360px;">
                    <div class="form-text">{{ 'meal.clarify.favorite_name_hint'|trans }}</div>
                </div>
            </div>

            {# Lead with the action that fits the confidence: when the AI is sure,
               saving is primary; when it isn't, re-analyzing is primary — but
               only while there are still questions to answer. Once the AI stops
               asking, another re-analysis can't help, so lead with Save. #}
            {% if not canReanalyze %}
            <p class="small text-muted" id="clarify-round-limit">{{ 'meal.clarify.round_limit'|trans }}</p>
            {% endif %}
            <div class="d-grid gap-2">
                {% if confidence.isConfident or questions is empty or not canReanalyze %}
                <button type="submit" name="accept" value="1" class="btn btn-success btn-lg fw-semibold">
                    <i class="bi bi-check-lg"></i> {{ 'meal.clarify.save'|trans }}
                </button>
                <button type="submit" name="favorite" value="1" class="btn btn-outline-warning fw-semibold">
                    <i class="bi bi-star"></i> {{ 'meal.clarify.save_fav'|trans }}
                </button>
                {% if canReanalyze %}
                <button type="submit" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-clockwise"></i> {{ 'meal.clarify.reanalyze'|trans }}
                </button>
                {% endif %}
                {% else %}
                <button type="submit" class="btn btn-success btn-lg fw-semibold">
                    <i class="bi bi-arrow-clockwise"></i> {{ 'meal.clarify.reanalyze'|trans }}
                </button>
                <button type="submit" name="accept" value="1" class="btn btn-outline-success fw-semibold">
                    <i class="bi bi-check-lg"></i> {{ 'meal.clarify.save_anyway'|trans }}
                </button>
                <button type="submit" name="favorite" value="1" class="btn btn-outline-warning fw-semibold">
                    <i class="bi bi-star"></i> {{ 'meal.clarify.save_fav'|trans }}
                </button>
                {% endif %}
            </div>

        </div>
    </div>
    </form>
</div>
{% endblock %}

{% block javascripts %}
<script>
// Generic reveal/hide for the collapsed secondary sections.
document.querySelectorAll('.js-toggle').forEach(el => {
    el.addEventListener('click', e => {
        e.preventDefault();
        const body = document.querySelector(el.dataset.target);
        body.classList.toggle('d-none');
        el.setAttribute('aria-expanded', body.classList.contains('d-none') ? 'false' : 'true');
    });
});

const tbody = document.querySelector('#ingredients-table tbody');

document.getElementById('add-ingredient').addEventListener('click', () => {
    const tr = document.createElement('tr');
    tr.innerHTML = `
        <td><input type="text" name="ing_name[]" class="form-control form-control-sm" required></td>
        <td><input type="text" name="ing_amount[]" class="form-control form-control-sm" placeholder="{{ 'meal.clarify.optional_ph'|trans }}"></td>
        <td><input type="text" name="ing_unit[]" class="form-control form-control-sm" placeholder="{{ 'meal.clarify.unit_ph'|trans }}"></td>
        <td class="text-center">
            <button type="button" class="btn btn-sm btn-link text-danger p-0 remove-row" title="{{ 'meal.clarify.remove'|trans }}">
                <i class="bi bi-x-lg"></i>
            </button>
        </td>`;
    tbody.appendChild(tr);
    tr.querySelector('input').focus();
});

tbody.addEventListener('click', e => {
    if (e.target.closest('.remove-row')) {
        e.target.closest('tr').remove();
    }
});

// Live-scale the displayed estimate by the servings multiplier so the control
// visibly works. The saved values are scaled server-side by the same factor.
const portionsInput = document.querySelector('input[name="portions"]');
const macroEls = document.querySelectorAll('.js-macro');
const subtitle = document.getElementById('nutrition-subtitle');
function renderScaledMacros() {
    // Mirror PortionScaler::normalize() — non-positive/blank falls back to 1 so the
    // preview never shows negative macros the server wouldn't save.
    const raw = parseFloat(portionsInput.value);
    const p = raw > 0 ? raw : 1;
    macroEls.forEach(el => {
        const base = parseFloat(el.dataset.base) || 0;
        el.textContent = Math.round(base * p) + (el.dataset.suffix || '');
    });
    if (subtitle) {
        const n = Math.round(p * 100) / 100;
        subtitle.textContent = n === 1
            ? {{ 'meal.clarify.for_one'|trans|json_encode|raw }}
            : {{ 'meal.clarify.for_n'|trans({'count': '@n@'})|json_encode|raw }}.replace('@n@', n);
    }
}
if (portionsInput) {
    portionsInput.addEventListener('input', renderScaledMacros);
    renderScaledMacros();
}

// The date row: "change" swaps the one-line summary for the editable field.
const loggedChange = document.getElementById('logged-change');
const loggedSummary = document.getElementById('logged-summary');
const loggedBody = document.getElementById('logged-body');
if (loggedChange) {
    loggedChange.addEventListener('click', e => {
        e.preventDefault();
        loggedSummary.classList.add('d-none');
        loggedBody.classList.remove('d-none');
    });
}

// Surface when the meal is being logged for a day other than today — reusing an older
// photo defaults the date to the photo's timestamp, so this keeps a backdate from being
// silent. Mirrors the server-rendered warning and updates live as the date is edited;
// a backdate also auto-opens the date row so the field being flagged is in view.
const loggedAtInput = document.getElementById('logged-at-input');
const backdateWarning = document.getElementById('backdate-warning');
const backdateDate = document.getElementById('backdate-date');
if (loggedAtInput && backdateWarning) {
    const today = loggedAtInput.dataset.today;
    const syncBackdateWarning = () => {
        const d = (loggedAtInput.value || '').slice(0, 10); // YYYY-MM-DD
        const isToday = d === '' || d === today;
        backdateWarning.classList.toggle('d-none', isToday);
        if (!isToday) {
            loggedSummary.classList.add('d-none');
            loggedBody.classList.remove('d-none');
        }
        if (!isToday && backdateDate) {
            const [y, m, day] = d.split('-').map(Number);
            backdateDate.textContent = new Date(y, m - 1, day)
                .toLocaleDateString(document.documentElement.lang || undefined,
                    { weekday: 'short', month: 'short', day: 'numeric' });
        }
    };
    loggedAtInput.addEventListener('input', syncBackdateWarning);
    loggedAtInput.addEventListener('change', syncBackdateWarning);
    // Run once on load so the JS and server renders can't drift (both are
    // locale-aware: local_date('EEEMMMd') server-side, toLocaleDateString here).
    syncBackdateWarning();
}
</script>
{% endblock %}
