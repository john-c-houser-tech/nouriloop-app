{% extends 'base.html.twig' %}

{% block title %}Favorite Savings — NouriLoop Admin{% endblock %}

{% block body %}
<div class="container" style="max-width: 960px;">
    <div class="d-flex align-items-center gap-3 mb-1">
        <h2 class="fw-bold mb-0"><i class="bi bi-graph-down-arrow text-brick"></i> Favorite Reuse Savings</h2>
        <a href="{{ path('app_admin_users') }}" class="btn btn-outline-secondary btn-sm ms-auto">
            <i class="bi bi-people"></i> Users
        </a>
    </div>
    <p class="text-muted">
        API spend avoided by logging meals from favorites instead of re-analyzing a photo.
    </p>

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card p-3 text-center h-100">
                <div class="fw-bold fs-3">{{ totals.calls|number_format }}</div>
                <small class="text-muted">Analyses skipped</small>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card p-3 text-center h-100 bg-success bg-opacity-10 border-0">
                <div class="fw-bold fs-3">{{ totals.tokens > 0 ? '~' ~ totals.tokens|number_format : '—' }}</div>
                <small class="text-muted">Tokens saved</small>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card p-3 text-center h-100">
                <div class="fw-bold fs-3">{{ totals.favorites|number_format }}</div>
                <small class="text-muted">Favorites</small>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card p-3 text-center h-100">
                <div class="fw-bold fs-3">{{ totals.users|number_format }}</div>
                <small class="text-muted">Users with favorites</small>
            </div>
        </div>
    </div>

    {% if rows is empty %}
        <div class="card p-5 text-center text-muted">
            <i class="bi bi-star fs-1"></i>
            <p class="mt-2 mb-0">No favorites have been created yet.</p>
        </div>
    {% else %}
        <div class="card">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>User</th>
                            <th class="text-end">Favorites</th>
                            <th class="text-end">Analyses skipped</th>
                            <th class="text-end">Tokens saved</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in rows %}
                        <tr>
                            <td>
                                <div class="fw-semibold">{{ row.displayName }}</div>
                                <div class="small text-muted">{{ row.email }}</div>
                            </td>
                            <td class="text-end">{{ row.favoriteCount|number_format }}</td>
                            <td class="text-end">{{ row.calls|number_format }}</td>
                            <td class="text-end">
                                {{ row.tokens > 0 ? '~' ~ row.tokens|number_format : '—' }}
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        <p class="small text-muted mt-2">
            Tokens are counted only for favorites saved from the review screen, where the
            analysis cost was captured; favorites made from an already-logged meal show “—”.
        </p>
    {% endif %}
</div>
{% endblock %}
