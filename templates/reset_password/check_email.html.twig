{% extends 'base.html.twig' %}

{% block title %}{{ 'auth.reset.check_heading'|trans }} — NouriLoop{% endblock %}

{% block body %}
<div class="min-vh-hero d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, #198754 0%, #0d6efd 100%);">
    <div class="card p-4 text-center" style="width: 100%; max-width: 420px;">
        <div style="font-size: 3rem;">📧</div>
        <h1 class="h3 fw-bold mb-3">{{ 'auth.reset.check_heading'|trans }}</h1>
        <p class="text-muted small">
            {{ 'auth.reset.check_lead'|trans({
                'expiration': resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle'),
            }) }}
        </p>
        <p class="small mb-0">
            {{ 'auth.reset.retry'|trans }} <a href="{{ path('app_forgot_password_request') }}">{{ 'auth.reset.try_again'|trans }}</a>
            · <a href="{{ path('app_login') }}">{{ 'auth.back_to_sign_in'|trans }}</a>
        </p>
    </div>
</div>
{% endblock %}
