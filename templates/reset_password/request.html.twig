{% extends 'base.html.twig' %}

{% block title %}{{ 'auth.reset.title'|trans }} — NouriLoop{% endblock %}

{% block body %}
<div class="min-vh-hero d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, #198754 0%, #0d6efd 100%);">
    <div class="card p-4" style="width: 100%; max-width: 420px;">
        <div class="text-center mb-4">
            <img src="{{ asset('auth-logo.png') }}" alt="NouriLoop" width="88" height="88" class="mb-2">
            <h1 class="h3 fw-bold mb-0">{{ 'auth.reset.title'|trans }}</h1>
            <p class="text-muted small">{{ 'auth.reset.subtitle'|trans }}</p>
        </div>

        {{ form_start(requestForm, {'attr': {'novalidate': 'novalidate'}}) }}
        <div class="mb-3">
            {{ form_label(requestForm.email, 'auth.reset.email', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
            {{ form_widget(requestForm.email, {'attr': {'class': 'form-control' ~ (requestForm.email.vars.errors|length ? ' is-invalid' : ''), 'autofocus': true}}) }}
            {{ form_errors(requestForm.email) }}
        </div>

        <button type="submit" class="btn btn-success w-100 fw-semibold">{{ 'auth.reset.submit'|trans }}</button>
        {{ form_end(requestForm) }}

        <hr>
        <p class="text-center mb-0 small">
            <a href="{{ path('app_login') }}">{{ 'auth.back_to_sign_in'|trans }}</a>
        </p>
    </div>
</div>
{% endblock %}
