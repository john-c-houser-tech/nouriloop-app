{# Slim, accessible cookie-consent banner. Only included when GA4 and/or the Meta Pixel
   is configured and the visitor hasn't decided (see base.html.twig). Accept → grant
   consent to both; Decline → leave both denied. Either choice is stored in a 6-month
   first-party cookie so the banner doesn't reappear. Pure vanilla JS (this app doesn't
   load Stimulus). #}
<div id="cookie-consent" role="dialog" aria-live="polite" aria-label="{{ 'chrome.cookies.aria'|trans }}"
     style="position: fixed; left: 1rem; right: 1rem; bottom: 1rem; z-index: 1080; max-width: 560px; margin: 0 auto;">
    <div class="card shadow border">
        <div class="card-body d-flex flex-column flex-sm-row align-items-sm-center gap-3 py-3">
            <div class="small text-muted flex-grow-1 mb-0">
                {{ 'chrome.cookies.text'|trans({
                    'link': '<a href="' ~ path('app_privacy_terms') ~ '#analytics">',
                    'link_end': '</a>',
                })|raw }}
            </div>
            <div class="d-flex gap-2 flex-shrink-0">
                <button type="button" id="cookie-decline" class="btn btn-sm btn-outline-secondary">{{ 'chrome.cookies.decline'|trans }}</button>
                <button type="button" id="cookie-accept" class="btn btn-sm btn-success">{{ 'chrome.cookies.accept'|trans }}</button>
            </div>
        </div>
    </div>
</div>
<script>
(function () {
    var banner = document.getElementById('cookie-consent');
    function decide(choice) {
        document.cookie = 'cookieConsent=' + choice + ';path=/;max-age=' + (60 * 60 * 24 * 182) + ';SameSite=Lax';
        if (choice === 'granted' && typeof gtag === 'function') {
            gtag('consent', 'update', {
                'analytics_storage': 'granted',
                'ad_storage': 'granted',
                'ad_user_data': 'granted',
                'ad_personalization': 'granted'
            });
        }
        if (choice === 'granted' && typeof fbq === 'function') {
            fbq('consent', 'grant');
        }
        if (banner) { banner.remove(); }
    }
    document.getElementById('cookie-accept').addEventListener('click', function () { decide('granted'); });
    document.getElementById('cookie-decline').addEventListener('click', function () { decide('denied'); });
})();
</script>
