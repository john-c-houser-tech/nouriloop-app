{% extends 'base.html.twig' %}
{% block title %}{{ 'goal.index.title'|trans }} — {{ brand.name }}{% endblock %}

{% block body %}
<div class="container" style="max-width: 820px;">
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
        <h2 class="fw-bold mb-0"><i class="bi bi-bullseye text-brick"></i> {{ 'goal.index.heading'|trans }} {{ help_link('goals') }}</h2>
        <a href="{{ path('app_goals_new') }}" class="btn btn-success btn-sm fw-semibold">
            <i class="bi bi-plus-lg"></i> {{ 'goal.index.new'|trans }}
        </a>
    </div>

    <p class="text-muted">{{ 'goal.index.lead'|trans }}</p>

    {% if goals is empty %}
    <div class="card p-4 text-center text-muted">
        <p class="mb-2">{{ 'goal.index.empty'|trans }}</p>
        <div><a href="{{ path('app_goals_new') }}" class="btn btn-outline-success btn-sm">{{ 'goal.index.create_first'|trans }}</a></div>
    </div>
    {% else %}
    <div class="list-group">
        {% for goal in goals %}
        {% set def = goal.definition %}
        <a href="{{ path('app_goals_show', {id: goal.id}) }}"
           class="list-group-item list-group-item-action d-flex justify-content-between align-items-start gap-3">
            <div>
                <div class="fw-semibold">
                    {{ goal.name }}
                    {% if not goal.isActive %}<span class="badge bg-secondary ms-1">{{ 'goal.index.paused'|trans }}</span>{% endif %}
                </div>
                <div class="small text-muted">{{ 'goal.summary_pattern'|trans({
                    'aggregation': def.aggregation.transKey|trans,
                    'metric': (def.metric.transKey|trans)|lower,
                    'direction': def.direction.transKey|trans,
                    'target': def.direction.value == 'maintain' and def.targetMax is not null
                        ? def.targetValue ~ '–' ~ def.targetMax
                        : def.targetValue,
                    'unit': def.unit,
                }) }}</div>
                <div class="small text-muted">
                    <i class="bi bi-clock"></i>
                    {{ goal.frequency.transKey|trans }}
                    {%- if goal.nextRunAt %} · {% if goal.nextRunAt <= date() %}{{ 'goal.index.due_now'|trans }}{% else %}{{ 'goal.index.next'|trans({'time': goal.nextRunAt|user_date('EEEMMMdjm')}) }}{% endif %}{% endif %}
                    · {{ (goal.outputFormat.transKey|trans)|lower }}
                </div>
            </div>
            <i class="bi bi-chevron-right text-muted"></i>
        </a>
        {% endfor %}
    </div>
    {% endif %}
</div>
{% endblock %}
