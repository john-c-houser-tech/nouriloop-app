{% extends 'base.html.twig' %}

{% block title %}{{ 'auth.link.sent_title'|trans }} — {{ brand.name }}{% endblock %}

{% block body %}
<div class="min-vh-hero d-flex align-items-center justify-content-center bg-hero">
    <div class="card p-4 text-center" style="width: 100%; max-width: 460px;">
        {% include '_brand_mark.html.twig' with {variant: 'auth', size: 88, class: 'mb-2 mx-auto', alt: brand.name} %}
        <h1 class="h3 fw-bold">{{ 'auth.link.sent_heading'|trans }}</h1>
        {# Uniform copy whether or not the account exists — no enumeration. #}
        <p class="text-muted">{{ 'auth.link.sent_lead'|trans }}</p>
        <p class="small text-muted mb-0">
            {{ 'auth.link.sent_nothing'|trans({
                'link': '<a href="' ~ path('app_login_link_request') ~ '">',
                'link_end': '</a>',
            })|raw }}
        </p>
        <hr>
        <p class="text-center mb-0 small">
            <a href="{{ path('app_login') }}">{{ 'auth.back_to_sign_in'|trans }}</a>
        </p>
    </div>
</div>
{% endblock %}
