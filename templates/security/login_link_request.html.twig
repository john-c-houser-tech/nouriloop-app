{% extends 'base.html.twig' %}

{% block title %}{{ 'auth.link.title'|trans }} — {{ brand.name }}{% endblock %}

{% block body %}
<div class="min-vh-hero d-flex align-items-center justify-content-center bg-hero">
    <div class="card p-4" style="width: 100%; max-width: 460px;">
        <div class="text-center mb-4">
            {% include '_brand_mark.html.twig' with {variant: 'auth', size: 88, class: 'mb-2', alt: brand.name} %}
            <h1 class="h3 fw-bold mb-0">{{ 'auth.link.heading'|trans }}</h1>
            <p class="text-muted small">{{ 'auth.link.subtitle'|trans }}</p>
        </div>

        <p class="small text-muted">{{ 'auth.link.lead'|trans }}</p>

        {% for message in app.flashes('error') %}
        <div class="alert alert-danger py-2">{{ message }}</div>
        {% endfor %}

        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

        <div class="mb-3">
            {{ form_label(form.email, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
            {{ form_widget(form.email, {'attr': {'class': 'form-control' ~ (form.email.vars.errors|length ? ' is-invalid' : ''), 'autofocus': true, 'autocomplete': 'email'}}) }}
            {{ form_errors(form.email) }}
        </div>

        {# Honeypot — hidden from people, tempting to bots. #}
        <div style="position: absolute; left: -5000px;" aria-hidden="true">
            {{ form_label(form.website) }}
            {{ form_widget(form.website, {'attr': {'tabindex': '-1', 'autocomplete': 'off'}}) }}
        </div>

        {% if turnstileSiteKey %}
        <div class="cf-turnstile mb-3" data-sitekey="{{ turnstileSiteKey }}"></div>
        {% endif %}

        <button type="submit" class="btn btn-success w-100 fw-semibold">{{ 'auth.link.submit'|trans }}</button>

        {{ form_end(form) }}

        <hr>
        <p class="text-center mb-0 small">
            <a href="{{ path('app_login') }}">{{ 'auth.back_to_sign_in'|trans }}</a>
            · {{ 'auth.link.new_here'|trans }} <a href="{{ path('app_register') }}">{{ 'auth.link.create_account'|trans }}</a>
        </p>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{% if turnstileSiteKey %}
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
{% endif %}
{% endblock %}
