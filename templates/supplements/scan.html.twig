{% extends 'base.html.twig' %}
{% block title %}{{ 'supplement.scan.title'|trans }} — {{ brand.name }}{% endblock %}

{% block body %}
<div class="container" style="max-width: 560px;">
    <div class="d-flex align-items-center gap-3 mb-4">
        <a href="{{ path('app_supplements') }}" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> {{ 'supplement.scan.back'|trans }}
        </a>
        <h2 class="fw-bold mb-0">{{ 'supplement.scan.title'|trans }}</h2>
    </div>

    <div class="card p-4">
        <p class="text-muted">{{ 'supplement.scan.lead'|trans|raw }}</p>

        {{ form_start(form) }}
        <div class="mb-3">
            {{ form_widget(form.images, {'attr': {'class': 'form-control', 'accept': 'image/*'}}) }}
            {{ form_errors(form.images) }}
        </div>
        <button type="submit" class="btn btn-success w-100 fw-semibold">
            <i class="bi bi-magic"></i> {{ 'supplement.scan.submit'|trans }}
        </button>
        {{ include('_allowance_counter.html.twig') }}
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
