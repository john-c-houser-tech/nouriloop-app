{% extends 'base.html.twig' %}
{% block title %}{{ 'supplement.scan.title'|trans }} — NouriLoop{% endblock %}

{% block body %}
<div class="container" style="max-width: 560px;">
    <div class="d-flex align-items-center gap-3 mb-4">
        <a href="{{ path('app_supplements') }}" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> {{ 'supplement.scan.back'|trans }}
        </a>
        <h2 class="fw-bold mb-0">{{ 'supplement.scan.title'|trans }}</h2>
    </div>

    <div class="card p-4">
        <p class="text-muted">{{ 'supplement.scan.lead'|trans|raw }}</p>

        {{ form_start(form) }}
        <div class="mb-3">
            {{ form_widget(form.images, {'attr': {'class': 'form-control', 'accept': 'image/*'}}) }}
            {{ form_errors(form.images) }}
        </div>
        <button type="submit" class="btn btn-success w-100 fw-semibold">
            <i class="bi bi-magic"></i> {{ 'supplement.scan.submit'|trans }}
        </button>
        {# Shared Free-tier allowance — a scan spends one monthly analysis. #}
        {% if freeRemaining is not null %}
        <p class="text-center small mt-2 mb-0 {{ freeRemaining <= 3 ? 'text-warning-emphasis fw-semibold' : 'text-muted' }}">
            {{ 'meal.log.allowance_left'|trans({'remaining': freeRemaining, 'limit': freeLimit}) }}
            {% if freeRemaining <= 3 %}
                · <a href="{{ path('app_pricing') }}">{{ 'meal.log.allowance_upgrade'|trans }}</a>
            {% endif %}
        </p>
        {% endif %}
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
