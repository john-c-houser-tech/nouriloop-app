{% extends 'base.html.twig' %}
{% block title %}{{ 'supplement.confirm.title'|trans }} — NouriLoop{% endblock %}

{% block body %}
<div class="container" style="max-width: 680px;">
    <h2 class="fw-bold mb-1">{{ 'supplement.confirm.title'|trans }}</h2>
    <p class="text-muted">
        {{ 'supplement.confirm.lead'|trans }}
        {% if state.confidence is defined %}
        <span class="badge bg-{{ state.confidence >= 0.75 ? 'success' : (state.confidence >= 0.5 ? 'warning text-dark' : 'danger') }}">
            {{ 'supplement.confirm.confidence'|trans({'pct': (state.confidence * 100)|round}) }}
        </span>
        {% endif %}
    </p>

    <form method="post" action="{{ path('app_supplement_confirm') }}" class="card p-4">
        <input type="hidden" name="_token" value="{{ csrf_token('supplement-confirm') }}">

        <div class="row g-3 mb-3">
            <div class="col-sm-8">
                <label class="form-label fw-semibold">{{ 'supplement.confirm.name'|trans }}</label>
                <input type="text" name="name" class="form-control" value="{{ state.name }}" required>
                {% if state.servingSize %}<div class="form-text">{{ 'supplement.confirm.serving_size'|trans({'size': state.servingSize}) }}</div>{% endif %}
            </div>
            <div class="col-sm-4">
                <label class="form-label fw-semibold">{{ 'supplement.confirm.servings_per_day'|trans }}</label>
                <input type="number" name="servings_per_day" class="form-control" value="1" min="0" step="0.25">
            </div>
        </div>

        <hr>
        <p class="fw-semibold mb-2">{{ 'supplement.confirm.macros'|trans }}</p>
        <div class="row g-2 mb-3">
            {% for key, meta in macroMeta %}
            <div class="col-sm-6">
                <div class="input-group input-group-sm mb-1">
                    <span class="input-group-text" style="min-width: 9rem;">{{ meta.label }}</span>
                    <input type="number" name="nutrient_{{ key }}" class="form-control"
                           value="{{ state.nutrients[key] is defined ? state.nutrients[key] : '' }}"
                           min="0" step="any" placeholder="0">
                    <span class="input-group-text">{{ meta.unit }}</span>
                </div>
            </div>
            {% endfor %}
        </div>

        <p class="fw-semibold mb-2">{{ 'supplement.confirm.micros'|trans }}</p>
        <div class="row g-2">
            {% for key, meta in nutrientMeta %}
            <div class="col-sm-6">
                <div class="input-group input-group-sm mb-1">
                    <span class="input-group-text" style="min-width: 9rem;">{{ meta.label }}</span>
                    <input type="number" name="nutrient_{{ key }}" class="form-control"
                           value="{{ state.nutrients[key] is defined ? state.nutrients[key] : '' }}"
                           min="0" step="any" placeholder="0">
                    <span class="input-group-text">{{ meta.unit }}</span>
                </div>
            </div>
            {% endfor %}
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-success fw-semibold">{{ 'supplement.confirm.save'|trans }}</button>
            <a href="{{ path('app_supplements') }}" class="btn btn-outline-secondary">{{ 'supplement.confirm.cancel'|trans }}</a>
        </div>
    </form>
</div>
{% endblock %}
