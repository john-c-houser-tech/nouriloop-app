{% extends 'base.html.twig' %}
{% block title %}{{ 'trends.title'|trans }} — NouriLoop{% endblock %}

{% block body %}
<div class="container">
    <div class="d-flex align-items-start justify-content-between mb-3 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-0"><i class="bi bi-graph-up text-brick"></i> {{ 'trends.title'|trans }} {{ help_link('inflammation') }}</h2>
            <p class="text-muted small mb-0">{{ 'trends.subtitle'|trans({'days': days}) }}</p>
        </div>
        <div class="btn-group">
            {% for d in [7, 14, 30, 90] %}
            <a href="{{ path('app_trends', {days: d}) }}"
               class="btn btn-{{ days == d ? 'success' : 'outline-secondary' }} btn-sm">{{ d }}d</a>
            {% endfor %}
        </div>
    </div>

    {# `correlations` is populated only for symptoms with *logged* entries — the same
       condition under which a per-symptom panel renders below — so a symptom-only user
       (no meals/health/sleep) still gets the dashboard, while an enabled-but-unlogged
       symptom alone correctly falls through to the empty state. #}
    {% if calorieTotals is empty and healthAggByType is empty and sleepData is empty and correlations is empty %}
    <div class="card p-5 text-center text-muted">
        <i class="bi bi-bar-chart fs-1 text-brick mb-2"></i>
        <p class="mb-2">{{ 'trends.empty'|trans }}</p>
        <a href="{{ path('app_meal_log') }}" class="btn btn-success btn-sm">{{ 'trends.log_first'|trans }}</a>
    </div>
    {% else %}

    <style>
        .insight-tile { cursor: pointer; transition: box-shadow .15s, transform .15s; }
        .insight-tile:hover:not(:disabled) { box-shadow: 0 .25rem .75rem rgba(0,0,0,.12); transform: translateY(-1px); }
        .insight-tile:disabled { cursor: default; }
        .insight-panel canvas { max-height: 60vh; }
        /* Give the time-series charts room to breathe instead of squashing them into
           a ~100–150px band. A fixed-height wrapper + maintainAspectRatio:false keeps
           the width responsive while the height stays generous. (The macro doughnut
           sizes itself and is left alone.) */
        .insight-chart-wrap { position: relative; height: 340px; }
        @media (max-width: 575.98px) { .insight-chart-wrap { height: 260px; } }
        /* Small-multiples stack: one compact panel per factor, own axis/units, no
           normalization. Panels share a left-aligned label column and only the
           bottom-most panel in a stack shows date ticks. */
        .symptom-multiples { display: flex; flex-direction: column; }
        .symptom-mini-panel { display: flex; align-items: stretch; gap: 8px; }
        .symptom-mini-label {
            width: 92px; flex: 0 0 92px; font-size: .75rem; color: var(--bs-secondary-color, #6c757d);
            display: flex; align-items: center; line-height: 1.15; padding-right: 4px;
        }
        .symptom-mini-chart { position: relative; flex: 1 1 auto; height: 56px; }
        .symptom-mini-panel.symptom-mini-symptom .symptom-mini-chart { height: 84px; }
        .symptom-mini-panel.symptom-mini-last .symptom-mini-chart { height: 76px; }
        @media (max-width: 575.98px) {
            .symptom-mini-label { width: 56px; flex-basis: 56px; font-size: .7rem; }
        }
    </style>

    {# Status → presentation. ok=green, watch=amber, alert=red, muted=disabled. #}
    {% set statusMeta = {
        'ok':    {border: 'border-success',   text: 'text-success',        icon: 'bi-check-circle-fill'},
        'watch': {border: 'border-warning',   text: 'text-warning',        icon: 'bi-exclamation-triangle-fill'},
        'alert': {border: 'border-danger',    text: 'text-danger',         icon: 'bi-exclamation-octagon-fill'},
        'muted': {border: 'border-secondary', text: 'text-muted',          icon: 'bi-dash-circle'},
    } %}
    {# Trend = which way the data has moved over the period (direction only). #}
    {% set trendMeta = {
        'up':   {icon: 'bi-arrow-up-right',   label: 'trends.trend_up'|trans},
        'down': {icon: 'bi-arrow-down-right', label: 'trends.trend_down'|trans},
        'flat': {icon: 'bi-arrow-right',      label: 'trends.trend_flat'|trans},
    } %}

    {# ════════════════════════════════════════════════════════════════════
       OVERVIEW — compact status tiles grouped by theme. Tap a tile to open
       its chart in the matching detail panel below (toggled by JS).
       ════════════════════════════════════════════════════════════════════ #}
    <div id="insight-overview">
        <div class="text-muted small mb-4">
            <p class="mb-2">{{ 'trends.tap_hint'|trans }}</p>
            <p class="mb-0">{{ 'trends.arrows_legend'|trans({'days': days})|raw }}</p>
        </div>
        {% for group in insightCards %}
        {% if group.cards is not empty %}
        <h5 class="fw-bold mb-2 {{ group.theme == 'consequences' ? 'text-consequence' : '' }}">
            {% if group.theme == 'consequences' %}<i class="bi bi-arrow-repeat"></i> {% endif %}{{ group.title }}
        </h5>
        <div class="row g-3 mb-4">
            {% for card in group.cards %}
            {% set sm = statusMeta[card.status] %}
            <div class="col-6 col-lg-3">
                {% if card.linkRoute is defined %}
                <a href="{{ path(card.linkRoute, card.linkParams|default({})) }}"
                   class="insight-tile card h-100 w-100 text-start p-3 border-2 text-decoration-none {{ sm.border }}">
                {% else %}
                <button type="button"
                        class="insight-tile card h-100 w-100 text-start p-3 border-2 {{ sm.border }}{{ not card.available ? ' opacity-50' : '' }}"
                        {% if card.available %}data-panel="{{ card.panel }}"{% if card.metric is defined %} data-metric="{{ card.metric }}"{% endif %}{% else %}disabled{% endif %}>
                {% endif %}
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="fw-semibold small text-body">{{ card.title }}</span>
                        <i class="bi {{ sm.icon }} {{ sm.text }}"></i>
                    </div>
                    <div class="fs-4 fw-bold lh-1 text-body">
                        {{ card.headline }}{% if card.unit %}<small class="text-muted fs-6 fw-normal"> {{ card.unit }}</small>{% endif %}
                        {% if card.trend is defined and card.trend %}{% set tm = trendMeta[card.trend] %}<i class="bi {{ tm.icon }} text-muted fs-6 ms-1" title="{{ 'trends.trend_title'|trans({'label': tm.label, 'days': days}) }}"></i>{% endif %}
                    </div>
                    <div class="small {{ card.available ? sm.text : 'text-muted' }} mt-1 text-truncate">{{ card.note }}</div>
                {% if card.linkRoute is defined %}</a>{% else %}</button>{% endif %}
            </div>
            {% endfor %}
        </div>
        {% endif %}
        {% endfor %}
    </div>

    {# ════════════════════════════════════════════════════════════════════
       DETAIL PANELS — one chart at a time, full width, with an explainer.
       Hidden by default; JS reveals the one whose tile was tapped.
       ════════════════════════════════════════════════════════════════════ #}

    {# ── Inflammation (+ symptom overlay + correlations) ─────────────────── #}
    {% if inflammationDaily is not empty %}
    <section class="insight-panel d-none" data-panel="inflammation">
        <a href="#" class="insight-back d-inline-flex align-items-center gap-1 text-decoration-none small mb-3">
            <i class="bi bi-arrow-left"></i> {{ 'trends.back'|trans }}
        </a>
        <div class="card p-4 mb-3 consequence-accent">
            <div class="mb-3">
                <h5 class="fw-bold mb-0">{{ 'trends.inflammation.heading'|trans }} {{ 'trends.last_days'|trans({'days': days}) }}</h5>
                <small class="text-muted">{{ 'trends.inflammation.legend'|trans }}</small>
            </div>
            <details class="small text-muted mb-3">
                <summary class="fw-semibold text-body">{{ 'trends.about'|trans }}</summary>
                {{ 'trends.inflammation.about'|trans|raw }}
            </details>
            <div class="insight-chart-wrap"><canvas id="inflammationChart"></canvas></div>
            {% if not hasEnabledSymptoms %}
            <div class="mt-3 small text-muted">
                <i class="bi bi-info-circle"></i>
                {{ 'trends.inflammation.track_symptom'|trans({
                    'link': '<a href="' ~ path('app_symptoms') ~ '">',
                    'link_end': '</a>',
                })|raw }}
            </div>
            {% endif %}
        </div>
    </section>
    {% endif %}

    {# ── Symptom relationships — one panel per enabled, logged symptom ────── #}
    {% for id, s in symptomSeriesByType %}
    {% if s.data is not empty %}
    {% set dietCorr   = symptomCorrelations[id].diet   ?? [] %}
    {% set healthCorr = symptomCorrelations[id].health ?? [] %}
    <section class="insight-panel d-none" data-panel="symptom-{{ id }}">
        <a href="#" class="insight-back d-inline-flex align-items-center gap-1 text-decoration-none small mb-3">
            <i class="bi bi-arrow-left"></i> {{ 'trends.back'|trans }}
        </a>
        <div class="card p-4 mb-3 consequence-accent">
            <div class="mb-3">
                <h5 class="fw-bold mb-0">{{ 'trends.symptom.heading'|trans({'label': s.label}) }} {{ 'trends.last_days'|trans({'days': days}) }}</h5>
                <small class="text-muted">{{ 'trends.symptom.legend'|trans({'label': s.label|lower|e})|raw }}</small>
            </div>

            <details class="small text-muted mb-3">
                <summary class="fw-semibold text-body">{{ 'trends.about_plural'|trans }}</summary>
                {{ 'trends.symptom.about'|trans({'label': s.label|lower|e, 'minDays': correlationMinDays})|raw }}
            </details>

            <h6 class="fw-semibold mb-1">{{ 'trends.symptom.diet_heading'|trans({'label': s.label|lower}) }}</h6>
            <div class="symptom-multiples" id="symptomDietMultiples-{{ id }}" data-symptom-id="{{ id }}"></div>

            {% if dietCorr is not empty %}
            <div class="mt-3 p-3 bg-light rounded small">
                <div class="fw-semibold mb-1"><i class="bi bi-link-45deg"></i> {{ 'trends.symptom.diet_corr'|trans }}</div>
                <ul class="mb-0">
                    {% for c in dietCorr %}
                    <li>{{ 'trends.symptom.corr_line'|trans({
                        'factor': c.label|e,
                        'relation': c.isPositive ? 'trends.symptom.corr_positive'|trans : 'trends.symptom.corr_negative'|trans,
                        'label': s.label|lower|e,
                        'lag': c.lagDays == 0 ? 'trends.symptom.same_day'|trans : 'trends.symptom.next_day'|trans,
                        'r': c.r,
                        'n': c.n,
                    })|raw }}</li>
                    {% endfor %}
                </ul>
            </div>
            {% endif %}

            {# Inflammation keeps its own pro-/other-day framing #}
            {% for c in correlations|filter(c => c.id == id) %}
            {% set sd = c.data.sameDay %}
            {% set nd = c.data.nextDay %}
            {% if sd.n > 0 %}
            <div class="mt-3 p-3 bg-light rounded small">
                <div class="fw-semibold mb-1">
                    <i class="bi bi-fire"></i>
                    {{ 'trends.symptom.inflammation_heading'|trans({'label': c.label|lower, 'n': sd.n}) }}
                </div>
                <ul class="mb-1">
                    <li>{{ 'trends.symptom.same_day_avg'|trans({
                        'label': c.label|lower|e,
                        'pro': sd.proAvgPain is not null ? sd.proAvgPain : '—',
                        'other': sd.otherAvgPain is not null ? sd.otherAvgPain : '—',
                        'r_note': sd.r is not null ? 'trends.symptom.r_note'|trans({'r': sd.r}) : '',
                    })|raw }}</li>
                    {% if nd.n > 0 %}
                    <li>{{ 'trends.symptom.next_day_avg'|trans({
                        'label': c.label|lower|e,
                        'pro': nd.proAvgPain is not null ? nd.proAvgPain : '—',
                        'other': nd.otherAvgPain is not null ? nd.otherAvgPain : '—',
                        'r_note': nd.r is not null ? 'trends.symptom.r_note_short'|trans({'r': nd.r}) : '',
                    })|raw }}</li>
                    {% endif %}
                </ul>
            </div>
            {% endif %}
            {% endfor %}

            {% if hasHealthFactors %}
            <h6 class="fw-semibold mt-4 mb-1">{{ 'trends.symptom.health_heading'|trans({'label': s.label|lower}) }}</h6>
            <div class="symptom-multiples" id="symptomHealthMultiples-{{ id }}" data-symptom-id="{{ id }}"></div>

            {% if healthCorr is not empty %}
            <div class="mt-3 p-3 bg-light rounded small">
                <div class="fw-semibold mb-1"><i class="bi bi-link-45deg"></i> {{ 'trends.symptom.health_corr'|trans }}</div>
                <ul class="mb-0">
                    {% for c in healthCorr %}
                    <li>{{ 'trends.symptom.corr_line'|trans({
                        'factor': c.label|e,
                        'relation': c.isPositive ? 'trends.symptom.corr_positive'|trans : 'trends.symptom.corr_negative'|trans,
                        'label': s.label|lower|e,
                        'lag': c.lagDays == 0 ? 'trends.symptom.same_day'|trans : 'trends.symptom.next_day'|trans,
                        'r': c.r,
                        'n': c.n,
                    })|raw }}</li>
                    {% endfor %}
                </ul>
            </div>
            {% endif %}
            {% endif %}

            {% if dietCorr is empty and healthCorr is empty %}
            <div class="mt-3 small text-muted">
                <i class="bi bi-info-circle"></i>
                {{ 'trends.symptom.no_corr'|trans }}
            </div>
            {% endif %}

            {# ── GLP-1 nausea-trigger flagging — only under the nausea symptom ── #}
            {% if nauseaTriggers and nauseaTypeId == id %}
            <hr class="my-4">
            <h6 class="fw-semibold mb-1"><i class="bi bi-capsule"></i> {{ 'trends.nausea.heading'|trans }}</h6>
            {% if nauseaTriggers.insufficient %}
            <div class="small text-muted">
                {{ 'trends.nausea.insufficient'|trans({'days': nauseaTriggers.evaluatedDays}) }}
            </div>
            {% elseif nauseaTriggers.triggers is empty %}
            <div class="small text-muted">
                {{ 'trends.nausea.none'|trans({'days': nauseaTriggers.evaluatedDays, 'avg': nauseaTriggers.overallAvg}) }}
            </div>
            {% else %}
            <div class="small text-muted mb-2">
                {{ 'trends.nausea.lead'|trans({'days': nauseaTriggers.evaluatedDays, 'avg': nauseaTriggers.overallAvg}) }}
            </div>
            <ul class="list-unstyled mb-0 small">
                {% for t in nauseaTriggers.triggers %}
                <li class="d-flex justify-content-between align-items-center border-bottom py-1 gap-2">
                    <span class="text-capitalize fw-semibold">{{ t.food }}</span>
                    <span class="text-muted text-end">
                        {{ 'trends.nausea.stats'|trans({'eaten': t.avgWhenEaten, 'not': t.avgWhenNot}) }}
                        <span class="badge bg-warning-subtle text-warning-emphasis ms-1">+{{ t.lift }}</span>
                        <span class="d-block d-sm-inline">{{ 'trends.nausea.days_eaten'|trans({'count': t.daysEaten}) }}</span>
                    </span>
                </li>
                {% endfor %}
            </ul>
            {% endif %}
            {% endif %}
        </div>
    </section>
    {% endif %}
    {% endfor %}

    {# ── Sleep (+ dinner→glucose→sleep table) ────────────────────────────── #}
    {% if sleepData is not empty %}
    <section class="insight-panel d-none" data-panel="sleep">
        <a href="#" class="insight-back d-inline-flex align-items-center gap-1 text-decoration-none small mb-3">
            <i class="bi bi-arrow-left"></i> {{ 'trends.back'|trans }}
        </a>
        <div class="card p-4 mb-3 consequence-accent">
            <div class="mb-3">
                <h5 class="fw-bold mb-0">{{ 'trends.sleep.heading'|trans }} {{ 'trends.last_days'|trans({'days': days}) }}</h5>
                <small class="text-muted">
                    {{ 'trends.sleep.bars'|trans }}
                    {% if sleepGapData is not empty %} {{ 'trends.sleep.gap_line'|trans }}{% endif %}
                    {% if nightlyData|filter(n => n.evening_glucose_peak is not null) is not empty %} {{ 'trends.sleep.glucose_dots'|trans }}{% endif %}
                </small>
            </div>
            <details class="small text-muted mb-3">
                <summary class="fw-semibold text-body">{{ 'trends.about'|trans }}</summary>
                {{ 'trends.sleep.about'|trans({'unit': glucoseUnit})|raw }}
            </details>
            <div class="insight-chart-wrap"><canvas id="sleepChart"></canvas></div>
        </div>

        {% if nightlyData is not empty %}
        <div class="card p-4 mb-4 consequence-accent">
            <h5 class="fw-bold mb-1">{{ 'trends.sleep.table_heading'|trans }}</h5>
            <p class="text-muted small mb-3">{{ 'trends.sleep.table_legend'|trans({'unit': glucoseUnit})|raw }}</p>
            <div class="table-responsive">
            <table class="table table-sm align-middle" style="font-size:.875rem;">
                <thead class="table-light">
                    <tr>
                        <th>{{ 'trends.sleep.col_night'|trans }}</th>
                        <th>{{ 'trends.sleep.col_dinner'|trans }}</th>
                        <th class="text-end">{{ 'trends.sleep.col_cal'|trans }}</th>
                        <th class="text-end">{{ 'trends.sleep.col_eve_glucose'|trans }}</th>
                        <th class="text-end">{{ 'trends.sleep.col_gap'|trans }}</th>
                        <th class="text-end">{{ 'trends.sleep.col_overnight'|trans }}</th>
                        <th class="text-end">{{ 'trends.sleep.col_sleep'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                {% for n in nightlyData|reverse %}
                <tr>
                    <td class="text-muted">{{ n.date|local_date('MMMd') }}</td>
                    <td>{{ n.dinner_time ?? '—' }}</td>
                    <td class="text-end">{{ n.dinner_calories is not null ? (n.dinner_calories|format_number) ~ ' kcal' : '—' }}</td>
                    <td class="text-end">
                        {% if n.evening_glucose_peak is not null %}
                            {% set gc = n.evening_glucose_peak < 140 ? 'success' : (n.evening_glucose_peak < 180 ? 'warning' : 'danger') %}
                            <span class="badge bg-{{ gc }}">{{ n.evening_glucose_display|format_number }} {{ glucoseUnit }}</span>
                        {% else %}—{% endif %}
                    </td>
                    <td class="text-end">
                        {% if n.gap_hours is not null %}
                            {% set gapc = n.gap_hours >= 3 ? 'success' : (n.gap_hours >= 2 ? 'warning' : 'danger') %}
                            <span class="badge bg-{{ gapc }}">{{ n.gap_hours|format_number }} hr</span>
                        {% else %}—{% endif %}
                    </td>
                    <td class="text-end">
                        {% if n.overnight_glucose is not null %}
                            {% set oc = n.overnight_glucose <= 100 ? 'success' : (n.overnight_glucose <= 140 ? 'warning' : 'danger') %}
                            <span class="badge bg-{{ oc }}">{{ n.overnight_glucose_display|format_number }} {{ glucoseUnit }}</span>
                        {% else %}—{% endif %}
                    </td>
                    <td class="text-end">
                        {% if n.sleep_hours is not null %}
                            {% set sc = n.sleep_hours >= 7 ? 'success' : (n.sleep_hours >= 6 ? 'warning' : 'danger') %}
                            <span class="badge bg-{{ sc }}">{{ n.sleep_hours|format_number }} hr</span>
                        {% else %}—{% endif %}
                    </td>
                </tr>
                {% endfor %}
                </tbody>
            </table>
            </div>
        </div>
        {% endif %}
    </section>
    {% endif %}

    {# ── Health metrics (per-metric tiles all open this shared chart) ─────── #}
    {% if healthAggByType is not empty %}
    <section class="insight-panel d-none" data-panel="health">
        <a href="#" class="insight-back d-inline-flex align-items-center gap-1 text-decoration-none small mb-3">
            <i class="bi bi-arrow-left"></i> {{ 'trends.back'|trans }}
        </a>
        <div class="card p-4 mb-4">
            <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                <div>
                    <h5 class="fw-bold mb-0">{{ 'trends.health.heading'|trans }} {{ 'trends.last_days'|trans({'days': days}) }}</h5>
                    <small class="text-muted">{{ 'trends.health.legend'|trans }}</small>
                </div>
                <div class="d-flex flex-wrap gap-2" id="metric-toggles">
                    {% for typeVal, meta in metricMeta %}
                    <button class="btn btn-sm btn-outline-secondary metric-toggle{{ loop.first ? ' active' : '' }}"
                            data-metric="{{ typeVal }}">
                        {{ meta.label }}
                        <small class="text-muted">({{ meta.unit }})</small>
                    </button>
                    {% endfor %}
                </div>
            </div>
            <details class="small text-muted mb-3">
                <summary class="fw-semibold text-body">{{ 'trends.about'|trans }}</summary>
                {{ 'trends.health.about'|trans|raw }}
            </details>
            <div class="insight-chart-wrap"><canvas id="healthChart"></canvas></div>
        </div>
    </section>
    {% endif %}

    {# ── Calories ────────────────────────────────────────────────────────── #}
    {% if calorieTotals is not empty %}
    <section class="insight-panel d-none" data-panel="calories">
        <a href="#" class="insight-back d-inline-flex align-items-center gap-1 text-decoration-none small mb-3">
            <i class="bi bi-arrow-left"></i> {{ 'trends.back'|trans }}
        </a>
        <div class="card p-4 mb-3">
            <h5 class="fw-bold mb-3">{{ 'trends.calories.heading'|trans }} {{ 'trends.last_days'|trans({'days': days}) }}</h5>
            <details class="small text-muted mb-3">
                <summary class="fw-semibold text-body">{{ 'trends.about'|trans }}</summary>
                {{ 'trends.calories.about'|trans|raw }}
            </details>
            <div class="insight-chart-wrap"><canvas id="calorieChart"></canvas></div>
        </div>
    </section>

    {# ── Macros ──────────────────────────────────────────────────────────── #}
    <section class="insight-panel d-none" data-panel="macros">
        <a href="#" class="insight-back d-inline-flex align-items-center gap-1 text-decoration-none small mb-3">
            <i class="bi bi-arrow-left"></i> {{ 'trends.back'|trans }}
        </a>
        <div class="card p-4 mb-3">
            <h5 class="fw-bold mb-3">{{ 'trends.macros.heading'|trans }}</h5>
            <details class="small text-muted mb-3">
                <summary class="fw-semibold text-body">{{ 'trends.about'|trans }}</summary>
                {{ 'trends.macros.about'|trans({'days': days})|raw }}
            </details>
            <canvas id="macroChart" height="160"></canvas>
        </div>
    </section>

    {% endif %}

    {% endif %}
</div>
{% endblock %}

{% block javascripts %}
{# Mirror the body's data check so the router/charts load whenever the dashboard
   renders — including the symptom-only case (correlations non-empty). #}
{% if calorieTotals is not empty or healthAggByType is not empty or sleepData is not empty or correlations is not empty %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>

{# Emit all PHP data as JS constants before entering verbatim #}
<script>
const calorieData    = {{ calorieTotals|json_encode|raw }};
const healthAggData  = {{ healthAggByType|json_encode|raw }};
const metricMeta     = {{ metricMeta|json_encode|raw }};
const avgsData       = {{ averages|json_encode|raw }};
const trendDays      = {{ days }};
const sleepNights    = {{ sleepData|json_encode|raw }};
const sleepGaps      = {{ sleepGapData|json_encode|raw }};
const nightlyData    = {{ nightlyData|json_encode|raw }};
const inflammationDaily = {{ inflammationDaily|json_encode|raw }};
const symptomSeriesByType = {{ symptomSeriesByType|json_encode|raw }};
const dailyMacros = {{ dailyMacros|json_encode|raw }};
const symptomHealthFactors = {{ symptomHealthFactors|json_encode|raw }};
const symptomHealthMeta = {{ symptomHealthMeta|json_encode|raw }};
const glucoseUnit = {{ glucoseUnit|json_encode|raw }};
{# Localized strings for the verbatim JS below — trans can't run inside
   {% verbatim %}, so everything user-visible is seeded here. #}
const L = {{ {
    'caloriesLabel': 'trends.js.calories_label'|trans,
    'inflammationLabel': 'trends.js.inflammation_label'|trans,
    'inflammationAxis': 'trends.js.inflammation_axis'|trans,
    'sleepLabel': 'trends.js.sleep_label'|trans,
    'hr': 'trends.js.hr'|trans,
    'gapLabel': 'trends.js.gap_label'|trans,
    'gapAxis': 'trends.js.gap_axis'|trans,
    'eveGlucoseLabel': 'trends.js.eve_glucose_label'|trans({'unit': glucoseUnit}),
    'tipGap': 'trends.js.tip_gap'|trans({'v': '@v@'}),
    'tipEveGlucose': 'trends.js.tip_eve_glucose'|trans({'v': '@v@', 'unit': glucoseUnit}),
    'tipSleep': 'trends.js.tip_sleep'|trans({'v': '@v@'}),
    'protein': 'trends.js.protein'|trans,
    'carbs': 'trends.js.carbs'|trans,
    'carbohydrates': 'trends.js.carbohydrates'|trans,
    'fat': 'trends.js.fat'|trans,
    'fiber': 'trends.js.fiber'|trans,
}|json_encode|raw }};
const DOC_LANG = document.documentElement.lang || 'en';
