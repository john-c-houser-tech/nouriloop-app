{% extends 'base.html.twig' %}

{% block title %}{{ 'settings.api_tokens.title'|trans }} — NouriLoop{% endblock %}

{% block body %}
<div class="container" style="max-width: 680px;">
    <a href="{{ path('app_settings_index') }}" class="small text-decoration-none d-inline-block mb-2">
        <i class="bi bi-arrow-left"></i> {{ 'settings.back'|trans }}
    </a>
    <h2 class="fw-bold mb-1">{{ 'settings.api_tokens.title'|trans }}</h2>
    <p class="text-muted">
        {{ 'settings.api_tokens.lead'|trans({
            'link': '<a href="' ~ path('app_connect_cgm') ~ '">',
            'link_end': '</a>',
        })|raw }}
    </p>

    {# One-time reveal of a freshly created token. #}
    {% for plaintext in app.flashes('api_token_new') %}
    <div class="card border-success p-3 mb-3">
        <label class="form-label fw-semibold text-success mb-1">
            <i class="bi bi-key-fill"></i> {{ 'settings.api_tokens.reveal'|trans }}
        </label>
        <div class="input-group">
            <input type="text" class="form-control font-monospace" value="{{ plaintext }}" readonly
                   id="new-token" onclick="this.select()">
            <button type="button" class="btn btn-outline-success"
                    onclick="navigator.clipboard.writeText(document.getElementById('new-token').value)">
                <i class="bi bi-clipboard"></i> {{ 'settings.api_tokens.copy'|trans }}
            </button>
        </div>
        <div class="form-text text-danger">{{ 'settings.api_tokens.reveal_warning'|trans }}</div>
    </div>
    {% endfor %}

    <div class="card p-4 mb-4">
        <form method="post" action="{{ path('app_settings_api_tokens') }}" class="row g-2 align-items-end">
            <input type="hidden" name="_token" value="{{ csrf_token('api-token-create') }}">
            <div class="col">
                <label class="form-label fw-semibold mb-1">{{ 'settings.api_tokens.new_label'|trans }}</label>
                <input type="text" name="name" class="form-control" maxlength="100"
                       placeholder="{{ 'settings.api_tokens.new_ph'|trans }}" autocomplete="off">
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-success fw-semibold">
                    <i class="bi bi-plus-lg"></i> {{ 'settings.api_tokens.create'|trans }}
                </button>
            </div>
        </form>
    </div>

    {% if tokens is empty %}
        <p class="text-muted text-center">{{ 'settings.api_tokens.none'|trans }}</p>
    {% else %}
        <div class="card">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>{{ 'settings.api_tokens.col_name'|trans }}</th>
                            <th>{{ 'settings.api_tokens.col_created'|trans }}</th>
                            <th>{{ 'settings.api_tokens.col_last_used'|trans }}</th>
                            <th class="text-end">{{ 'settings.api_tokens.col_actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for token in tokens %}
                        <tr>
                            <td class="fw-semibold">{{ token.name }}</td>
                            <td class="small text-muted">{{ token.createdAt|user_date('yMMMd') }}</td>
                            <td class="small text-muted">
                                {{ token.lastUsedAt ? token.lastUsedAt|user_date('yMMMdjm') : 'settings.api_tokens.never'|trans }}
                            </td>
                            <td class="text-end">
                                <form method="post"
                                      action="{{ path('app_settings_api_token_delete', {id: token.id}) }}"
                                      onsubmit="return confirm('{{ 'settings.api_tokens.revoke_confirm'|trans({'name': token.name})|e('js') }}')">
                                    <input type="hidden" name="_token"
                                           value="{{ csrf_token('api-token-delete-' ~ token.id) }}">
                                    <button class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i> {{ 'settings.api_tokens.revoke'|trans }}
                                    </button>
                                </form>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}

    <div class="card p-3 mt-4 bg-light border-0">
        <h6 class="fw-bold mb-2"><i class="bi bi-info-circle"></i> {{ 'settings.api_tokens.usage'|trans }}</h6>

        <p class="small fw-semibold mb-1">{{ 'settings.api_tokens.hae_heading'|trans }}</p>
        <p class="small mb-2">{{ 'settings.api_tokens.hae_text'|trans|raw }}</p>
        <pre class="bg-body rounded p-2 small mb-3">POST {{ app.request.schemeAndHttpHost }}/api/health-metrics/health-export
Authorization: Bearer &lt;your token&gt;</pre>
        <p class="small text-muted mb-3">{{ 'settings.api_tokens.hae_tip'|trans|raw }}</p>

        <p class="small fw-semibold mb-1">{{ 'settings.api_tokens.custom_heading'|trans }}</p>
        <p class="small mb-2">{{ 'settings.api_tokens.custom_text'|trans }}</p>
        <pre class="bg-body rounded p-2 small mb-0">POST {{ app.request.schemeAndHttpHost }}/api/health-metrics
Authorization: Bearer &lt;your token&gt;
Content-Type: application/json

{"metrics": [
  {"type": "weight", "value": 72.4,
   "recordedAt": "2026-06-10T08:32:00-07:00", "source": "iPhone"}
]}</pre>
    </div>
</div>
{% endblock %}
