{% extends 'base.html.twig' %}

{% block title %}{{ 'settings.index.title'|trans }} — NouriLoop{% endblock %}

{% block body %}
<div class="container" style="max-width: 900px;">
    <h1 class="fw-bold mb-1"><i class="bi bi-gear text-brick"></i> {{ 'settings.index.title'|trans }}</h1>
    <p class="text-muted mb-4">{{ 'settings.index.lead'|trans }}</p>

    {# Category headings must outrank the item cards visually — they were both
       h5-sized, which flattened the hierarchy and made the page hard to scan.
       Heading: h5 size + rule; items: h6 (1rem, body size — deliberately not
       smaller, the audience skews older) and semibold rather than bold. The
       tags also now nest h1 → h2 → h3 properly. #}
    {% for key, category in categories %}
    <h2 class="h5 fw-bold mb-3 pb-2 border-bottom">{{ category.label|trans }}</h2>
    <div class="row g-3 mb-4">
        {% for item in category.items %}
        <div class="col-md-6">
            <a href="{{ path(item.route) }}"
               class="card h-100 p-3 text-decoration-none text-body border-2 help-topic-card">
                <h3 class="h6 fw-semibold mb-0"><i class="bi {{ item.icon }} text-success me-1"></i> {{ item.label|trans }}</h3>
            </a>
        </div>
        {% endfor %}
    </div>
    {% endfor %}
</div>
{% endblock %}
