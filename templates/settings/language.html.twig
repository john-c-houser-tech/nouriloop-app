{% extends 'base.html.twig' %}

{% block title %}{{ 'settings.language.title'|trans }} — NouriLoop{% endblock %}

{% block body %}
<div class="container" style="max-width: 680px;">
    <a href="{{ path('app_settings_index') }}" class="small text-decoration-none d-inline-block mb-2">
        <i class="bi bi-arrow-left"></i> {{ 'settings.back'|trans }}
    </a>
    <h2 class="fw-bold mb-1">{{ 'settings.language.title'|trans }}</h2>
    <p class="text-muted">{{ 'settings.language.lead'|trans }}</p>

    <div class="card p-4 mt-3">
        {{ form_start(form) }}

        <div class="mb-3">
            {{ form_label(form.locale, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
            <div>
                {% for choice in form.locale %}
                <div class="form-check">
                    {{ form_widget(choice, {'attr': {'class': 'form-check-input'}}) }}
                    {{ form_label(choice, null, {'label_attr': {'class': 'form-check-label'}}) }}
                </div>
                {% endfor %}
            </div>
            <div class="form-text">{{ form_help(form.locale) }}</div>
            {{ form_errors(form.locale) }}
        </div>

        <button type="submit" class="btn btn-success fw-semibold mt-2">{{ 'settings.language.save'|trans }}</button>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
