{% extends 'base.html.twig' %}

{% block title %}{{ 'settings.subscription.title'|trans }} — NouriLoop{% endblock %}

{% block body %}
<div class="container py-4" style="max-width: 640px;">
    <a href="{{ path('app_settings_index') }}" class="small text-decoration-none d-inline-block mb-2">
        <i class="bi bi-arrow-left"></i> {{ 'settings.back'|trans }}
    </a>
    <h2 class="fw-bold mb-4"><i class="bi bi-stars text-success"></i> {{ 'settings.subscription.title'|trans }}</h2>

    <div class="card p-4 mb-3">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <div class="text-muted small text-uppercase">{{ 'settings.subscription.current_plan'|trans }}</div>
                <div class="fs-4 fw-bold">{{ tier.label }}</div>
            </div>
            {% if tier.value == 'free' %}
                <a href="{{ path('app_pricing') }}" class="btn btn-success">
                    <i class="bi bi-stars"></i> {{ 'settings.subscription.upgrade'|trans }}
                </a>
            {% else %}
                <a href="{{ path('app_pricing') }}" class="btn btn-outline-success">{{ 'settings.subscription.change_plan'|trans }}</a>
            {% endif %}
        </div>
    </div>

    {% if hasActiveStripe %}
    <div class="card p-4">
        <h5 class="fw-bold">{{ 'settings.subscription.manage_heading'|trans }}</h5>
        <p class="text-muted small">{{ 'settings.subscription.manage_text'|trans }}</p>
        <form method="post" action="{{ path('app_subscription_portal') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('subscription-portal') }}">
            <button type="submit" class="btn btn-outline-secondary">
                <i class="bi bi-credit-card"></i> {{ 'settings.subscription.manage_btn'|trans }}
            </button>
        </form>
    </div>
    {% else %}
    <p class="text-muted small">
        {{ 'settings.subscription.no_billing'|trans({
            'link': '<a href="' ~ path('app_pricing') ~ '">',
            'link_end': '</a>',
        })|raw }}
    </p>
    {% endif %}
</div>
{% endblock %}
