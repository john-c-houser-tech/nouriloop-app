# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
DATABASE_URL="mysql://nutrition_user:!ChangeMe!@127.0.0.1:3306/nutrition?serverVersion=12.3.2-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
# The From address must equal the authenticated IONOS mailbox or an alias of it
# (IONOS rejects unrelated From addresses). info@nouriloop.com is an ALIAS: SMTP
# auth (prod Postfix SASL) stays john@nouriloop.com — only this visible From header
# changes, never the credentials. Prod overrides this in .env.local; this committed
# default is only for dev (where Mailpit catches everything).
MAILER_FROM="NouriLoop <info@nouriloop.com>"
# Reply-To on every mail: an unmonitored address, so replies don't land in the From mailbox.
MAILER_REPLY_TO=noreply@nouriloop.com
# Recipient for team-facing notices (new-user + beta-request admin notices, feedback).
# Decoupled from any admin account's login email — override in .env.local if it changes.
ADMIN_EMAIL=info@nouriloop.com
###< symfony/mailer ###

###> symfony/twilio-notifier ###
# For real SMS delivery, put your credentials in the untracked .env.local:
#   TWILIO_DSN=twilio://ACCOUNT_SID:AUTH_TOKEN@default?from=+15555550123
# Left empty here so SMS is simply logged (and skipped) until configured.
TWILIO_DSN=
###< symfony/twilio-notifier ###

###> cloudflare/turnstile ###
# CAPTCHA for the public "request an invitation" form. Put real keys in the
# untracked .env.local. Left empty here, so verification is skipped (the form
# still works) until configured.
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
###< cloudflare/turnstile ###

###> app/hosting ###
# hosted = NouriLoop's own service (billing, tiers, allowances).
# self   = a self-hosted copy: no billing, every account gets every feature, and the
#          pricing / checkout / Stripe webhook routes answer 404 (ADR 0003).
APP_HOSTING_MODE=hosted
# DEFAULT_URI (above) is this instance's public address: links in emails sent by the
# scheduled commands, and the address the Connect-your-CGM wizard tells users to paste
# into Health Auto Export. Self-hosters set it to their own https URL.
# Branding for a self-hosted copy (NouriLoop's name, logo and documents belong to NouriLoop
# LLC; see the README's trademark note). All optional:
#   APP_NAME       what the copy is called; default: its own domain (from DEFAULT_URI)
#   APP_LOGO_URL   logo image URL; default: none
#   OPERATOR_EMAIL who runs it; shown on the built-in legal page and in security.txt
#   PRIVACY_URL / TERMS_URL  where your own privacy policy / terms live
#   SOURCE_URL     where users can get this copy's source code (AGPL-3.0 §13: if you
#                  modify NouriLoop and run it for others, point this at your fork)
APP_NAME=
APP_LOGO_URL=
OPERATOR_EMAIL=
PRIVACY_URL=
TERMS_URL=
SOURCE_URL=
###< app/hosting ###

###> app/ai-provider ###
# Which AI service answers every AI call (ADR 0003). Defaults keep the hosted service
# exactly as it was: Anthropic, with ANTHROPIC_API_KEY from .env.local.
#   AI_PROVIDER=anthropic          -> Anthropic's API. AI_MODEL / AI_MODEL_LIGHT, when
#                                     set, replace claude-sonnet-4-6 / claude-haiku-4-5.
#   AI_PROVIDER=openai_compatible  -> any OpenAI-compatible endpoint. Needs AI_BASE_URL
#                                     and AI_MODEL; AI_API_KEY is optional (a local
#                                     Ollama server needs none). AI_MODEL_LIGHT (help
#                                     answers) falls back to AI_MODEL. Examples:
#       OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1  (model ids: openrouter.ai/models)
#       Ollama:     AI_BASE_URL=http://localhost:11434/v1     (model names: `ollama list`)
# Meal, recipe and supplement photos need a model that can read images.
# Put a real AI_API_KEY in .env.local, never here.
AI_PROVIDER=anthropic
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_MODEL_LIGHT=
# Encrypts the API keys users store under Settings > AI provider (base64 of 32 random
# bytes). Generate one with:  php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'
# and put it in .env.local. Left blank, users can't save a key. Never change it once
# keys are stored: the old keys would no longer decrypt.
USER_SECRETS_KEY=
###< app/ai-provider ###

###> app/glucose-insights ###
# The Glucose Insights page's deterministic rankings are always on. The AI
# "pattern coach" deep-dive is a separate, higher-cost tier (it would spend Claude
# tokens per analysis), so it ships gated off and is presented as a locked upsell.
# Flip to 1 here (or per-deploy in .env.local) once the tier + its cost model exist.
GLUCOSE_AI_INSIGHTS_ENABLED=0
###< app/glucose-insights ###

# Stripe — non-secret committed defaults so the container compiles everywhere
# (CI/test has no .env.local). Real test/live values live in the untracked
# .env.local; the secret key, webhook secret, and price IDs MUST be overridden there.
# Billing is monthly only: Loop ($2, bring your own key) and Loop+ ($13.50, AI included).
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_LOOP_MONTHLY_PRICE_ID=price_loop_monthly_placeholder
STRIPE_LOOP_PLUS_MONTHLY_PRICE_ID=price_loop_plus_monthly_placeholder
# One-off Loop+ allowance top-up ($1.75 for 60 analyses this month, PR 7b).
STRIPE_TOP_UP_PRICE_ID=price_top_up_placeholder

###> app/seo ###
# Date (YYYY-MM-DD) used as <lastmod> in /sitemap.xml. Set per-deploy in the
# server's .env.local (the deploy script can stamp it); empty here, so dev/test
# fall back to today's date.
DEPLOY_DATE=
# GA4 Measurement ID (G-XXXXXXXXXX). Empty here → analytics + cookie banner are
# fully suppressed (dev/test/CI). Real ID goes in the server's .env.local only.
GOOGLE_ANALYTICS_ID=
###< app/seo ###

###> app/meta-pixel ###
# Meta (Facebook/Instagram) Pixel ID, numeric. Empty here → the pixel is fully
# suppressed (dev/test/CI), same kill-switch pattern as GOOGLE_ANALYTICS_ID. Real ID
# goes in the server's .env.local only. Unlike GA4, the pixel loads ONLY on
# unauthenticated pages plus the one-shot sign_up/purchase conversion redirects —
# never on any page behind login — since Meta Pixel is used for ad-audience
# building, not just analytics, and health-adjacent page views must never reach it
# (see the Meta Pixel section in CLAUDE.md for why).
META_PIXEL_ID=
###< app/meta-pixel ###

###> app/version ###
# Release version shown in the footer. Stamped per-deploy into the server's
# .env.local from `git describe --tags --always` (see Deploying an update);
# empty here, so dev/test/CI simply show no version.
APP_VERSION=
###< app/version ###


